<div class="min-h-screen">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    <!-- Header with navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">
          Property Details
        </h1>
        <p class="text-slate-300 text-sm lg:text-base">
          Customer: <span class="text-emerald-400 font-semibold"><%= @property.customer.name %></span>
          <span class="text-slate-400 mx-2">•</span>
          <span class="text-blue-400 font-semibold"><%= @property.property_name %></span>
        </p>
      </div>
      <div class="flex items-center space-x-3">
        <%= link_to edit_property_path(@property), 
            class: "inline-flex items-center px-4 py-2 bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white rounded-xl transition-all duration-200 transform hover:scale-[1.02]" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Edit Property
        <% end %>
        <%= link_to edit_customer_path(@property.customer), 
            class: "inline-flex items-center px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl transition-all duration-200 transform hover:scale-[1.02]" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Customer
        <% end %>
      </div>
    </div>
    <!-- Main content grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Property Information -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Basic Information Card -->
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-white">Basic Information</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1">
              <label class="block text-slate-400 text-sm font-medium">Property Type</label>
              <p class="text-white text-lg font-semibold"><%= @property.property_type.presence || "Not specified" %></p>
            </div>
            <div class="space-y-1">
              <label class="block text-slate-400 text-sm font-medium">Property Name</label>
              <p class="text-white text-lg font-semibold"><%= @property.property_name.presence || "Unnamed Property" %></p>
            </div>
            <div class="space-y-1">
              <label class="block text-slate-400 text-sm font-medium">Construction Type</label>
              <p class="text-white text-lg font-semibold"><%= @property.construction_type.presence || "Not specified" %></p>
            </div>
            <div class="space-y-1">
              <label class="block text-slate-400 text-sm font-medium">ZIP Code</label>
              <p class="text-white text-lg font-semibold"><%= @property.zip_code.presence || "Not specified" %></p>
            </div>
          </div>
        </div>
        <!-- Location Information Card -->
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 bg-emerald-500/20 rounded-xl flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h2 class="text-xl font-bold text-white">Location Details</h2>
          </div>
          <div class="space-y-6">
            <div class="space-y-1">
              <label class="block text-slate-400 text-sm font-medium">Address</label>
              <p class="text-white text-lg">
                <%= @property.address.presence || "Address not provided" %>
              </p>
            </div>
            <div class="space-y-1">
              <label class="block text-slate-400 text-sm font-medium">City</label>
              <p class="text-white text-lg">
                <%= @property.city.presence || "City not specified" %>
              </p>
            </div>
            <% if @property.address.present? && @property.city.present? %>
              <div class="bg-white/5 rounded-2xl p-4 border border-white/10">
                <div class="flex items-center text-sm text-slate-300">
                  <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-1.447-.894L15 4m0 13V4m-6 3l6-3"/>
                  </svg>
                  Complete Address: <%= [@property.address, @property.city, @property.zip_code].compact.join(", ") %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <!-- Notes Section -->
        <% if @property.note.present? %>
          <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
            <div class="flex items-center mb-6">
              <div class="w-10 h-10 bg-amber-500/20 rounded-xl flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <h2 class="text-xl font-bold text-white">Additional Notes</h2>
            </div>
            <div class="bg-white/5 rounded-2xl p-4 border border-white/10">
              <p class="text-slate-300 leading-relaxed whitespace-pre-wrap"><%= @property.note %></p>
            </div>
          </div>
        <% end %>
      </div>
      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Quick Actions -->
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 border border-white/20 shadow-2xl animate-slide-up">
          <h3 class="text-lg font-bold text-white mb-4">Quick Actions</h3>
          <div class="space-y-3">
            <%= link_to new_inspection_path(property_id: @property.id), 
    class: "w-full inline-flex items-center justify-center px-4 py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
              </svg>
              New Inspection
            <% end %>
            <%= link_to property_inspections_path(@property), 
    class: "w-full inline-flex items-center justify-center px-4 py-3 bg-slate-700 hover:bg-slate-600 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              View Inspections
            <% end %>
          </div>
        </div>
        <!-- Property Status -->
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
          <h3 class="text-lg font-bold text-white mb-4">Property Status</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-slate-300 text-sm">Total Inspections</span>
              <span class="text-white font-bold text-lg">
                <%= @property.inspections.count %>
              </span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-300 text-sm">Recent Inspections</span>
              <span class="text-emerald-400 font-bold text-lg">
                <%= @property.inspections.where('created_at > ?', 30.days.ago).count %>
              </span>
            </div>
            <div class="border-t border-white/10 pt-4">
              <div class="flex items-center space-x-2">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-slate-400 text-sm">Created:</span>
                <span class="text-slate-300 text-sm"><%= @property.created_at.strftime("%B %d, %Y") %></span>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              <span class="text-slate-400 text-sm">Last Updated:</span>
              <span class="text-slate-300 text-sm"><%= @property.updated_at.strftime("%B %d, %Y") %></span>
            </div>
          </div>
        </div>
        <!-- Customer Information -->
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
          <h3 class="text-lg font-bold text-white mb-4">Customer Info</h3>
          <div class="space-y-3">
            <div>
              <label class="block text-slate-400 text-xs font-medium uppercase tracking-wide">Customer Name</label>
              <p class="text-white font-semibold"><%= @property.customer.name %></p>
            </div>
            <% if @property.customer.email.present? %>
              <div>
                <label class="block text-slate-400 text-xs font-medium uppercase tracking-wide">Email</label>
                <p class="text-slate-300 text-sm"><%= @property.customer.email %></p>
              </div>
            <% end %>
            <% if @property.customer.phone_1.present? %>
              <div>
                <label class="block text-slate-400 text-xs font-medium uppercase tracking-wide">Phone</label>
                <p class="text-slate-300 text-sm"><%= @property.customer.phone_1 %></p>
              </div>
            <% end %>
            <div class="pt-3">
              <%= link_to edit_customer_path(@property.customer), 
                  class: "inline-flex items-center text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors duration-200" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                View Customer Details
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
