<% duplicate_info = session[:duplicate_next_inspection] %>
<% existing = duplicate_info['existing'] %>

<div id="duplicateModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg shadow-xl max-w-3xl w-full mx-4 max-h-[90vh] overflow-y-auto">
    <!-- Header -->
    <div class="bg-gradient-to-r from-amber-500 to-orange-500 text-white px-6 py-4 rounded-t-lg">
      <div class="flex items-center">
        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
        </svg>
        <h3 class="text-xl font-bold">Duplicate Next Inspection Detected</h3>
      </div>
    </div>

    <!-- Content -->
    <div class="p-6">
      <div class="mb-6">
        <p class="text-gray-700 text-lg mb-4">
          A <strong>Next Inspection</strong> already exists for this property with the same system category and interval.
        </p>
      </div>

      <!-- Inspection information in two columns -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Existing Next Inspection information -->
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-semibold text-gray-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Existing Next Inspection
          </h4>
          <div class="space-y-2 text-sm">
            <div>
              <span class="font-medium text-gray-600">Customer:</span>
              <span class="text-gray-800 block"><%= existing['customer_name'] %></span>
            </div>
            <div>
              <span class="font-medium text-gray-600">Property:</span>
              <span class="text-gray-800 block"><%= existing['property_name'] %></span>
            </div>
            <div>
              <span class="font-medium text-gray-600">System:</span>
              <span class="text-gray-800 block"><%= existing['system_category'] %></span>
            </div>
            <div>
              <span class="font-medium text-gray-600">Interval:</span>
              <span class="text-gray-800 block"><%= existing['interval_category'] %></span>
            </div>
            <div>
              <span class="font-medium text-gray-600">Scheduled Date:</span>
              <span class="text-gray-800 font-semibold block"><%= existing['next_inspection_date'] %></span>
            </div>
            <div>
              <span class="font-medium text-gray-600">Status:</span>
              <span class="px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 inline-block mt-1">
                <%= existing['status']&.humanize || 'Scheduled' %>
              </span>
            </div>
            <div>
              <span class="font-medium text-gray-600">Created:</span>
              <span class="text-gray-800 block"><%= Time.parse(existing['created_at'].to_s).strftime("%m/%d/%Y at %H:%M") %></span>
            </div>
          </div>
        </div>

        <!-- New Next Inspection information -->
        <div class="bg-green-50 rounded-lg p-4">
          <h4 class="font-semibold text-gray-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Next Inspection to Create
          </h4>
          <div class="space-y-2 text-sm">
            <div>
              <span class="font-medium text-gray-600">New scheduled date:</span>
              <span class="text-gray-800 font-semibold block text-lg"><%= duplicate_info['new_date'] %></span>
            </div>
            <div class="mt-4 p-3 bg-green-100 rounded-lg">
              <p class="text-green-800 text-xs">
                This new inspection will be based on the current inspection date plus the configured interval.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- User question -->
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700 font-medium">
              What would you like to do?
            </p>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-col gap-3">
        <!-- Main buttons in row -->
        <div class="flex flex-col sm:flex-row gap-3">
          <%= form_with url: handle_duplicate_next_inspections_path, method: :post, local: true, class: "flex-1" do |form| %>
            <%= form.hidden_field :action_type, value: 'delete_existing' %>
            <%= form.submit "Delete existing and create new", 
                class: "w-full bg-red-600 hover:bg-red-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200 flex items-center justify-center text-sm",
                data: { 
                  confirm: "Are you sure you want to delete the existing Next Inspection (#{existing['next_inspection_date']}) and create a new one (#{duplicate_info['new_date']})?" 
                } %>
          <% end %>

          <%= form_with url: handle_duplicate_next_inspections_path, method: :post, local: true, class: "flex-1" do |form| %>
            <%= form.hidden_field :action_type, value: 'keep_existing' %>
            <%= form.submit "Keep existing", 
                class: "w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200 flex items-center justify-center text-sm" %>
          <% end %>
        </div>

        <!-- Separate cancel button -->
        <div class="border-t border-gray-200 pt-3">
          <%= form_with url: handle_duplicate_next_inspections_path, method: :post, local: true, class: "w-full" do |form| %>
            <%= form.hidden_field :action_type, value: 'cancel' %>
            <%= form.submit "Cancel PDF generation", 
                class: "w-full bg-gray-500 hover:bg-gray-600 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200 flex items-center justify-center text-sm" %>
          <% end %>
        </div>
      </div>

      <!-- Additional information -->
      <div class="mt-4 text-xs text-gray-500 text-center space-y-2">
        <div class="bg-blue-50 rounded-lg p-3 text-left">
          <p class="font-medium text-blue-800 mb-2">Available options:</p>
          <ul class="space-y-1 text-blue-700">
            <li>• <strong>Delete and create new:</strong> Replaces the existing inspection with a new date</li>
            <li>• <strong>Keep existing:</strong> Preserves the current inspection without changes</li>
            <li>• <strong>Cancel:</strong> Does not create any inspection and cancels PDF generation</li>
          </ul>
        </div>
        <p class="text-gray-600">After choosing an option, PDF generation will proceed (except if you cancel).</p>
      </div>
    </div>
  </div>
</div>

<script>
  // Prevent modal from closing when clicking outside
  document.getElementById('duplicateModal').addEventListener('click', function(e) {
    e.stopPropagation();
  });
</script>