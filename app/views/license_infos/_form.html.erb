<%= form_with(model: license_info, local: true, class: "contents") do |form| %>
  <% if license_info.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-4 mb-6 animate-slide-up">
      <div class="flex items-center mb-3">
        <svg class="w-5 h-5 text-red-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h3 class="text-red-400 font-semibold">
          <%= pluralize(license_info.errors.count, "error") %> prohibited this license from being saved:
        </h3>
      </div>
      <ul class="list-disc list-inside space-y-1">
        <% license_info.errors.each do |error| %>
          <li class="text-red-300 text-sm"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <div class="animate-fade-in">
      <%= form.label :license_number, class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
      <div class="relative">
        <%= form.text_field :license_number, class: ["w-full bg-white/5 border rounded-xl py-3 pl-4 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200", license_info.errors[:license_number].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"], placeholder: "Enter license number" %>
      </div>
    </div>

    <div class="animate-fade-in">
      <label class="block text-white font-semibold text-sm lg:text-base mb-4">License Type</label>
      <div class="space-y-4">
        <!-- SFM Checkbox -->
        <div class="bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-white/10 hover:border-white/20 transition-all duration-200">
          <label class="flex items-center cursor-pointer">
            <%= form.check_box :sfm,
                class: "w-5 h-5 rounded border-2 border-white/20 bg-white/5 text-indigo-600 focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900 transition-all duration-200 cursor-pointer" %>
            <div class="ml-3 flex-1">
              <span class="text-white font-medium">State Fire Marshal (SFM)</span>
              <p class="text-slate-400 text-sm mt-1">Fire protection and life safety systems license</p>
            </div>
            <div class="ml-3">
              <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
              </svg>
            </div>
          </label>
        </div>
        <!-- CSLB Checkbox -->
        <div class="bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-white/10 hover:border-white/20 transition-all duration-200">
          <label class="flex items-center cursor-pointer">
            <%= form.check_box :cslb,
                class: "w-5 h-5 rounded border-2 border-white/20 bg-white/5 text-indigo-600 focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900 transition-all duration-200 cursor-pointer" %>
            <div class="ml-3 flex-1">
              <span class="text-white font-medium">Contractors State License Board (CSLB)</span>
              <p class="text-slate-400 text-sm mt-1">General contractor license for construction services</p>
            </div>
            <div class="ml-3">
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
          </label>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 pt-4">
      <%= form.submit class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900" %>
      <%= link_to "Cancel", settings_path, class: "bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 px-6 rounded-xl transition-colors duration-200 text-center focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 focus:ring-offset-slate-900" %>
    </div>
  </div>
<% end %>