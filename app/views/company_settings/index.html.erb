<% content_for :head do %>
  <style>
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideUp {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.6s ease-in-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
    
    .stagger-animation {
      animation-delay: calc(var(--animation-order) * 0.1s);
    }
  </style>
<% end %>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">
          Inspection Settings
        </h1>
        <p class="text-slate-300 text-sm lg:text-base">
          Manage system deficiencies and intervals
        </p>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-3">
        <%= link_to root_path, 
            class: "inline-flex items-center bg-slate-700 hover:bg-slate-600 text-white py-2 px-4 rounded-xl transition-colors duration-200 text-sm lg:text-base" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back
        <% end %>
      </div>
    </div>

    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">
        
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center">
              <div class="w-10 h-10 bg-gradient-to-r from-amber-500 to-orange-600 rounded-xl flex items-center justify-center mr-3">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xl lg:text-2xl font-bold text-white">Deficiencies</h2>
                <p class="text-slate-300 text-sm">
                  <%= pluralize(@deficiencies.count, 'deficiency') %> registered
                </p>
              </div>
            </div>
            
            <%= link_to "Add", new_deficiency_path, 
                class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] text-sm" %>
          </div>
          
          <% if @deficiencies.any? %>
            <div class="space-y-3">
              <% @deficiencies.each_with_index do |deficiency, index| %>
                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-white/10 hover:bg-white/10 transition-all duration-200 group animate-fade-in stagger-animation" 
                     style="--animation-order: <%= index + 1 %>;">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="w-8 h-8 bg-amber-500/20 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01"/>
                        </svg>
                      </div>
                      <div>
                        <h3 class="text-white font-semibold text-sm lg:text-base group-hover:text-indigo-300 transition-colors">
                          <%= deficiency.name %>
                        </h3>
                        <p class="text-slate-400 text-xs">
                          ID: <%= deficiency.id %>
                        </p>
                      </div>
                    </div>
                    
                    <div class="flex items-center space-x-2">
                      <%= link_to edit_deficiency_path(deficiency), 
                          class: "text-slate-400 hover:text-indigo-400 transition-colors p-1" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      <% end %>
                      
                      <%= link_to deficiency_path(deficiency), method: :delete, 
                          data: { confirm: "Are you sure you want to delete this deficiency?" },
                          class: "text-slate-400 hover:text-red-400 transition-colors p-1" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mt-1">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-2">No deficiencies registered</h3>
                  <p class="text-slate-300 text-sm">Start by adding your first deficiency to the system.</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center">
              <div class="w-10 h-10 bg-gradient-to-r from-emerald-500 to-emerald-700 rounded-xl flex items-center justify-center mr-3">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xl lg:text-2xl font-bold text-white">Intervals</h2>
                <p class="text-slate-300 text-sm">
                  <%= pluralize(@intervals.count, 'interval') %> registered
                </p>
              </div>
            </div>
            
            <%= link_to "Add", new_interval_category_path, 
                class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] text-sm" %>
          </div>
          
          <% if @intervals.any? %>
            <div class="space-y-3">
              <% @intervals.each_with_index do |interval, index| %>
                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-white/10 hover:bg-white/10 transition-all duration-200 group animate-fade-in stagger-animation" 
                     style="--animation-order: <%= index + 1 %>;">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="w-8 h-8 bg-emerald-500/20 rounded-lg flex items-center justify-center mr-3">
                        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"/>
                        </svg>
                      </div>
                      <div>
                        <h3 class="text-white font-semibold text-sm lg:text-base group-hover:text-indigo-300 transition-colors">
                          <%= interval.name %>
                        </h3>
                        <p class="text-slate-400 text-xs">
                          ID: <%= interval.id %>
                        </p>
                      </div>
                    </div>
                    
                    <div class="flex items-center space-x-2">
                      <%= link_to edit_interval_category_path(interval), 
                          class: "text-slate-400 hover:text-indigo-400 transition-colors p-1" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      <% end %>
                      
                      <%= link_to interval_category_path(interval), method: :delete, 
                          data: { confirm: "Are you sure you want to delete this interval?" },
                          class: "text-slate-400 hover:text-red-400 transition-colors p-1" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mt-1">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-2">No intervals registered</h3>
                  <p class="text-slate-300 text-sm">Start by adding your first interval to the system.</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center">
              <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-700 rounded-xl flex items-center justify-center mr-3">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xl lg:text-2xl font-bold text-white">System Categories</h2>
                <p class="text-slate-300 text-sm">
                  <%= pluralize(@system_categories.count, 'category') %> registered
                </p>
              </div>
            </div>
            
            <%= link_to "Add", new_system_category_path, 
                class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] text-sm" %>
          </div>
          
          <% if @system_categories.any? %>
            <div class="space-y-3">
              <% @system_categories.each_with_index do |category, index| %>
                <div class="bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-white/10 hover:bg-white/10 transition-all duration-200 group animate-fade-in stagger-animation" 
                     style="--animation-order: <%= index + 1 %>;">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <div class="w-12 h-12 bg-white/5 rounded-lg flex items-center justify-center mr-3 border border-white/10">
                        <% if category.thumbnail.attached? %>
                          <%= image_tag category.thumbnail, 
                              class: "w-10 h-10 rounded-lg object-cover", 
                              alt: category.name %>
                        <% else %>
                          <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                        <% end %>
                      </div>
                      <div>
                        <h3 class="text-white font-semibold text-sm lg:text-base group-hover:text-indigo-300 transition-colors">
                          <%= category.name %>
                        </h3>
                        <p class="text-slate-400 text-xs">
                          ID: <%= category.id %>
                          <% if category.thumbnail.attached? %>
                            <span class="inline-flex items-center ml-2">
                              <svg class="w-3 h-3 text-green-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                              </svg>
                              <span class="text-green-400">With image</span>
                            </span>
                          <% end %>
                        </p>
                      </div>
                    </div>
                    
                    <div class="flex items-center space-x-2">
                      <%= link_to edit_system_category_path(category), 
                          class: "text-slate-400 hover:text-indigo-400 transition-colors p-1" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      <% end %>
                      
                      <%= link_to system_category_path(category), method: :delete, 
                          data: { confirm: "Are you sure you want to delete this category?" },
                          class: "text-slate-400 hover:text-red-400 transition-colors p-1" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mt-1">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-white font-semibold mb-2">No categories registered</h3>
                  <p class="text-slate-300 text-sm">Start by adding your first system category.</p>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
      </div>
    </div>
  </div>
</div>