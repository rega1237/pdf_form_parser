<%= form_with(model: contractor_info, local: true, class: "contents") do |form| %>
  <% if contractor_info.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-4 mb-6 animate-slide-up">
      <div class="flex items-center mb-3">
        <svg class="w-5 h-5 text-red-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h3 class="text-red-400 font-semibold">
          <%= pluralize(contractor_info.errors.count, "error") %> prevented this contractor from being saved:
        </h3>
      </div>
      <ul class="list-disc list-inside space-y-1">
        <% contractor_info.errors.each do |error| %>
          <li class="text-red-300 text-sm"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="space-y-6">
    <!-- Name Field -->
    <div class="animate-fade-in">
      <%= form.label :name, "Contractor Name", 
          class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <%= form.text_field :name,
            class: ["w-full bg-white/5 border rounded-xl py-3 pl-12 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                   contractor_info.errors[:name].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
            placeholder: "Enter contractor name" %>
      </div>
      <% if contractor_info.errors[:name].any? %>
        <div class="mt-2 flex items-center text-red-400 text-sm">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
          </svg>
          <%= contractor_info.errors[:name].first %>
        </div>
      <% end %>
    </div>
    <!-- Address Field -->
    <div class="animate-fade-in">
      <%= form.label :address, "Address", 
          class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <%= form.text_field :address,
            class: ["w-full bg-white/5 border rounded-xl py-3 pl-12 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                   contractor_info.errors[:address].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
            placeholder: "Street address" %>
      </div>
      <% if contractor_info.errors[:address].any? %>
        <div class="mt-2 flex items-center text-red-400 text-sm">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
          </svg>
          <%= contractor_info.errors[:address].first %>
        </div>
      <% end %>
    </div>
    <!-- City, State, ZIP Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 animate-fade-in">
      <!-- City -->
      <div class="md:col-span-1">
        <%= form.label :city, "City", 
            class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
        <%= form.text_field :city,
            class: ["w-full bg-white/5 border rounded-xl py-3 px-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                   contractor_info.errors[:city].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
            placeholder: "City" %>
        <% if contractor_info.errors[:city].any? %>
          <div class="mt-2 flex items-center text-red-400 text-sm">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
            </svg>
            <%= contractor_info.errors[:city].first %>
          </div>
        <% end %>
      </div>
      <!-- State -->
      <div class="md:col-span-1">
        <%= form.label :state, "State", 
            class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
        <%= form.text_field :state,
            class: ["w-full bg-white/5 border rounded-xl py-3 px-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                   contractor_info.errors[:state].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
            placeholder: "CA",
            maxlength: 2 %>
        <% if contractor_info.errors[:state].any? %>
          <div class="mt-2 flex items-center text-red-400 text-sm">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
            </svg>
            <%= contractor_info.errors[:state].first %>
          </div>
        <% end %>
      </div>
      <!-- ZIP -->
      <div class="md:col-span-1">
        <%= form.label :zip, "ZIP Code", 
            class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
        <%= form.number_field :zip,
            class: ["w-full bg-white/5 border rounded-xl py-3 px-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                   contractor_info.errors[:zip].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
            placeholder: "90210" %>
        <% if contractor_info.errors[:zip].any? %>
          <div class="mt-2 flex items-center text-red-400 text-sm">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
            </svg>
            <%= contractor_info.errors[:zip].first %>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Phone and Job Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 animate-fade-in">
      <!-- Phone -->
      <div>
        <%= form.label :phone, "Phone Number", 
            class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <%= form.text_field :phone,
              class: ["w-full bg-white/5 border rounded-xl py-3 pl-12 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                     contractor_info.errors[:phone].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
              placeholder: "(555) 123-4567" %>
        </div>
        <% if contractor_info.errors[:phone].any? %>
          <div class="mt-2 flex items-center text-red-400 text-sm">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
            </svg>
            <%= contractor_info.errors[:phone].first %>
          </div>
        <% end %>
      </div>
      <!-- Job -->
      <div>
        <%= form.label :job, "Job Number", 
            class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <%= form.number_field :job,
              class: ["w-full bg-white/5 border rounded-xl py-3 pl-12 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                     contractor_info.errors[:job].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
              placeholder: "Enter job number" %>
        </div>
        <% if contractor_info.errors[:job].any? %>
          <div class="mt-2 flex items-center text-red-400 text-sm">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
            </svg>
            <%= contractor_info.errors[:job].first %>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Misc Field -->
    <div class="animate-fade-in">
      <%= form.label :misc, "Additional Information", 
          class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
      <%= form.text_area :misc,
          class: ["w-full bg-white/5 border rounded-xl py-3 px-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                 contractor_info.errors[:misc].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
          placeholder: "Any additional notes or information...",
          rows: 4 %>
      <% if contractor_info.errors[:misc].any? %>
        <div class="mt-2 flex items-center text-red-400 text-sm">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
          </svg>
          <%= contractor_info.errors[:misc].first %>
        </div>
      <% end %>
    </div>
    <!-- Informational section -->
    <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
      <div class="flex items-start space-x-3">
        <div class="w-8 h-8 bg-emerald-500/20 rounded-lg flex items-center justify-center mt-1">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-2">Tips for contractor information</h3>
          <ul class="text-slate-300 text-sm space-y-1">
            <li>• Ensure all contact information is accurate and up-to-date</li>
            <li>• Use consistent formatting for phone numbers</li>
            <li>• Include complete address details for official records</li>
            <li>• Add relevant notes in the additional information field</li>
          </ul>
        </div>
      </div>
    </div>
    <!-- Action buttons -->
    <div class="flex flex-col sm:flex-row gap-3 pt-4">
      <%= form.submit class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900" %>
      <%= link_to "Cancel", contractor_infos_path, 
          class: "bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 px-6 rounded-xl transition-colors duration-200 text-center focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 focus:ring-offset-slate-900" %>
    </div>
  </div>
<% end %>