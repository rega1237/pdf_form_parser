<% content_for :head do %>
  <style>
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideUp {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.6s ease-in-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
    
    .stagger-animation {
      animation-delay: calc(var(--animation-order) * 0.1s);
    }

    .file-upload-area {
      transition: all 0.3s ease;
    }
    .file-upload-area:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(99, 102, 241, 0.15);
    }
    .drag-over {
      border-color: #6366f1 !important;
      background-color: rgba(99, 102, 241, 0.05) !important;
    }
    .interval-category-btn.selected {
      background-color: rgba(59, 130, 246, 0.3); /* bg-blue-600/30 */
      border-color: rgba(96, 165, 250, 0.7); /* border-blue-400/70 */
    }
  </style>
<% end %>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900" data-controller="file-upload">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">New Template</h1>
        <p class="text-slate-400 text-sm lg:text-base">
          Upload a template file for creating inspection forms
        </p>
      </div>
      <%= link_to form_templates_path, class: "inline-flex items-center px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl transition-colors duration-200 text-sm font-medium" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Templates
      <% end %>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
        <%= form_with(model: @form_template, url: form_templates_path, local: true, html: { multipart: true, class: "space-y-6" }) do |form| %>
          
          <%# Manejo de errores %>
          <% if @form_template.errors.any? %>
            <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-4 animate-slide-up">
              <div class="flex items-center mb-3">
                <svg class="w-5 h-5 text-red-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <h3 class="text-red-400 font-semibold"><%= pluralize(@form_template.errors.count, "error") %> found:</h3>
              </div>
              <ul class="space-y-1 text-red-300 text-sm ml-7 list-disc">
                <% @form_template.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="space-y-2">
            <%= form.label :name, "Template name", class: "block text-white font-semibold text-sm lg:text-base" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              </div>
              <%= form.text_field :name, class: "w-full bg-white/5 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200", placeholder: "E.g.: Industrial safety inspection" %>
            </div>
          </div>

          <div data-controller="inspection-modal"
               data-inspection-modal-selection-mode-value="multiple"
               data-inspection-modal-system-categories-value="<%= @system_categories.map { |sc| { id: sc.id, name: sc.name, thumbnail_url: (url_for(sc.thumbnail) if sc.thumbnail.attached?) } }.to_json %>"
               data-inspection-modal-interval-categories-value="<%= @interval_categories.to_json(only: [:id, :name]) %>">
            
            <div data-inspection-modal-target="formContent" class="space-y-4">
              <div>
                <%= form.label :system_category, "System Category", class: "block text-white font-semibold text-sm mb-2" %>
                <button type="button" data-action="click->inspection-modal#openSystemModal" class="flex items-center justify-between w-full p-3 bg-slate-700/50 border border-white/10 rounded-lg hover:border-white/20 transition-colors">
                  <span data-inspection-modal-target="systemCategoryDisplay" class="text-slate-400 category-display">Select System Category</span>
                  <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
                </button>
                <%= form.hidden_field :system_category, "data-inspection-modal-target": "systemCategoryInput" %>
              </div>
              
              <div>
                <%= form.label :interval_category_ids, "Interval Categories", class: "block text-white font-semibold text-sm mb-2" %>
                <button type="button" data-action="click->inspection-modal#openIntervalModal" class="flex items-center justify-between w-full p-3 bg-slate-700/50 border border-white/10 rounded-lg hover:border-white/20 transition-colors">
                  <span data-inspection-modal-target="intervalCategoryDisplay" class="text-slate-400 category-display">Select Interval Categories</span>
                  <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
                </button>
                
                <div data-inspection-modal-target="intervalCheckboxesContainer" class="hidden">
                  <% @interval_categories.each do |category| %>
                    <%= form.check_box :interval_category_ids, { multiple: true, checked: @form_template.interval_category_ids.include?(category.id), id: "form_template_interval_category_ids_#{category.id}" }, category.id, nil %>
                  <% end %>
                </div>
              </div>
            </div>

            <div data-inspection-modal-target="systemSelection" class="hidden">
              <h2 class="text-xl font-bold text-white mb-4">Select System</h2>
              <div data-inspection-modal-target="systemCategoryButtons" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>
            </div>
            <div data-inspection-modal-target="intervalSelection" class="hidden">
              <h2 class="text-xl font-bold text-white mb-4">Select Intervals</h2>
              <div data-inspection-modal-target="intervalCategoryButtons" class="space-y-3"></div>
            </div>
          </div>

          <div class="space-y-2">
            <%= form.label :original_file, "Template file", class: "block text-white font-semibold text-sm lg:text-base" %>
            <p class="text-slate-400 text-xs lg:text-sm mb-3">Supported formats: PDF</p>
            
            <%= form.file_field :original_file, class: "hidden", accept: ".pdf", data: { file_upload_target: "fileInput", action: "change->file-upload#fileChanged" } %>
            
            <div class="file-upload-area bg-white/5 border-2 border-dashed border-white/20 rounded-2xl p-6 lg:p-8 text-center hover:border-indigo-400/50 transition-all duration-300 relative" data-file-upload-target="uploadArea" data-action="dragover->file-upload#dragOver dragleave->file-upload#dragLeave drop->file-upload#drop">
              <div class="space-y-4">
                <div class="w-16 h-16 lg:w-20 lg:h-20 bg-indigo-500/20 rounded-2xl flex items-center justify-center mx-auto"><svg class="w-8 h-8 lg:w-10 lg:h-10 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg></div>
                <div>
                  <h3 class="text-white font-semibold text-lg mb-2">File upload</h3>
                  <p class="text-slate-400 text-sm lg:text-base mb-4">Drag and drop your file here, or click to select</p>
                  <button type="button" class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-colors duration-200" data-action="click->file-upload#triggerFileInput">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    Select file
                  </button>
                </div>
                <div data-file-upload-target="fileInfo" class="hidden bg-white/5 rounded-xl p-4 text-left">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <svg class="w-5 h-5 text-emerald-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                      <span data-file-upload-target="fileName" class="text-white font-medium text-sm"></span>
                    </div>
                    <button type="button" data-action="click->file-upload#clearFile" class="text-slate-400 hover:text-white transition-colors"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
                  </div>
                  <p data-file-upload-target="fileSize" class="text-slate-400 text-xs mt-1"></p>
                </div>
              </div>
            </div>
          </div>

          <div class="pt-4">
            <%= form.submit "Create template", class: "w-full bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-4 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900 text-base lg:text-lg" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>