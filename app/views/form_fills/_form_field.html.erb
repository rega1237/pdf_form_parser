<%# app/views/form_fills/_form_field.html.erb %>
<%# Partial para renderizar un campo individual del formulario %>

<%# --- Verificaciones iniciales --- %>
<% return unless local_assigns.key?(:field) && field.is_a?(Hash) && field.key?('name') && field['name'].present? %>
<% return unless local_assigns.key?(:form) %>
<% return unless local_assigns.key?(:field_id) %>

<%# --- Lógica de renderizado de campos --- %>

<% if field['type'] == "Pass/Fail" %>
  <div data-pagination-skip-trigger="true">
    <%= form.label field['name'],
        raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"),
        for: field_id,
        class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <%= hidden_field_tag "form_fill[#{field['name']}]", field['value'], id: "hidden_input_#{field_id}" %>
    <div class="choice-button-group" data-controller="choice-buttons" data-hidden-input-id="hidden_input_<%= field_id %>">
      <button type="button" class="choice-button" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="Pass">Pass</button>
      <button type="button" class="choice-button" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="Fail">Fail</button>
      <button type="button" class="choice-button" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="N/A">N/A</button>
    </div>
  </div>

<% elsif field['type'] == "Photo" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <%= form.file_field field['name'], id: field_id, accept: "image/*", capture: "environment", class: "hidden" %>
    <div data-controller="photo-capture" data-photo-capture-input-id-value="<%= field_id %>">
      <button type="button" data-action="click->photo-capture#openCamera" class="w-full flex items-center justify-center bg-gradient-to-br from-purple-500 to-purple-700 hover:from-purple-600 hover:to-purple-800 text-white font-bold py-6 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl border-2 border-purple-400">
        <svg class="w-8 h-8 mr-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0118.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span class="text-lg"><% if field['photo_attachment_id'].present? %>Change Photo<% else %>Take Photo<% end %></span>
      </button>
      <div id="photo-preview-<%= field_id %>" data-photo-capture-target="preview" class="mt-4 <%= field['photo_attachment_id'].present? ? '' : 'hidden' %>">
        <div class="relative bg-slate-700 rounded-2xl p-4 border-2 border-blue-400">
          <div class="flex items-center justify-between mb-3"><span class="text-white font-semibold text-sm"><% if field['photo_attachment_id'].present? %>Saved photo:<% else %>Captured photo:<% end %></span>
            <div class="flex space-x-2"><% if Rails.env.development? %><button type="button" data-action="click->photo-capture#debugRemovePhoto" class="text-yellow-400 hover:text-yellow-300 transition-colors text-xs">🐛</button><% end %><button type="button" data-action="click->photo-capture#removePhoto" class="text-red-400 hover:text-red-300 transition-colors"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button></div>
          </div>
          <% if field['photo_attachment_id'].present? %><% existing_photo = @form_fill.get_photo_for_field(field['name']) %><% if existing_photo.present? %><%= image_tag rails_blob_path(existing_photo), data: { photo_capture_target: "image" }, class: "w-full object-cover rounded-xl border border-slate-600", alt: "Photo of #{field['label_name'].presence || field['name']}" %><% else %><img data-photo-capture-target="image" class="w-full object-cover rounded-xl border border-slate-600" alt="Captured photo" src=""><% end %><% else %><img data-photo-capture-target="image" class="w-full object-cover rounded-xl border border-slate-600" alt="Captured photo" src=""><% end %><% if field['photo_attachment_id'].present? %><div class="file-info text-xs text-slate-300 mt-2"><div class="flex justify-between items-center"><span class="flex items-center"><svg class="w-3 h-3 mr-1 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg><%= field['label_name'].presence || field['name'] %></span><span class="text-green-400">Saved</span></div></div><% end %>
        </div>
      </div>
    </div>
    <% if Rails.env.development? && field['photo_attachment_id'].present? %><div class="mt-2 text-xs text-purple-300 bg-purple-900/20 rounded p-2"><strong>Debug:</strong> photo_attachment_id: <%= field['photo_attachment_id'] %></div><% end %>
  </div>

<% elsif field['type'] == "Deficiency" %>
  <div class="space-y-4">
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative hidden"><svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg><%= form.text_field "#{field['name']}_item", id: "#{field_id}_item", value: field['Item'] || '', class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20", placeholder: "Item..." %></div>
    <div class="relative"><svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path></svg><%= form.number_field "#{field['name']}_riser", id: "#{field_id}_riser", value: field['Riser'] || '', required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20", placeholder: "Riser Number..." %></div>
    <div class="grid grid-cols-2 gap-4">
      <div class="relative inline-block w-full checkbox-button"><%= check_box_tag "#{field['name']}_c", 'Yes', field['C'] == 'Yes', { id: "#{field_id}_c", class: "hidden peer" } %><label for="<%= "#{field_id}_c" %>" class="checkbox-button-label flex items-center justify-center text-center py-4 px-5 md:p-6 text-base md:text-lg font-semibold min-h-[60px] md:min-h-[70px] rounded-2xl cursor-pointer transition-all duration-300 ease-in-out shadow-md bg-gradient-to-br from-blue-100 to-blue-200 border-2 border-blue-600 text-blue-900 hover:from-blue-200 hover:to-blue-400 hover:border-blue-700 hover:-translate-y-0.5 hover:shadow-lg peer-checked:from-blue-600 peer-checked:to-blue-700 peer-checked:border-blue-900 peer-checked:text-white peer-checked:shadow-xl">C</label></div>
      <div class="relative inline-block w-full checkbox-button"><%= check_box_tag "#{field['name']}_d", 'Yes', field['D'] == 'Yes', { id: "#{field_id}_d", class: "hidden peer" } %><label for="<%= "#{field_id}_d" %>" class="checkbox-button-label flex items-center justify-center text-center py-4 px-5 md:p-6 text-base md:text-lg font-semibold min-h-[60px] md:min-h-[70px] rounded-2xl cursor-pointer transition-all duration-300 ease-in-out shadow-md bg-gradient-to-br from-green-100 to-green-200 border-2 border-green-600 text-green-900 hover:from-green-200 hover:to-green-400 hover:border-green-700 hover:-translate-y-0.5 hover:shadow-lg peer-checked:from-green-600 peer-checked:to-green-700 peer-checked:border-green-900 peer-checked:text-white peer-checked:shadow-xl">D</label></div>
    </div>
    <div class="relative"><svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path></svg><%= form.select "#{field['name']}_select", options_for_select(field['options'].map { |option| [option.is_a?(Array) ? option.first : option, option.is_a?(Array) ? option.last : option] }, field['value']), { include_blank: 'Select an option' }, id: "#{field_id}_select", required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md appearance-none bg-white/95 border-2 border-blue-800 text-blue-900 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" %></div>
    <div class="relative"><svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg><%= form.text_field "#{field['name']}_comment", id: "#{field_id}_comment", value: field['comment_value'] || '', class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20", placeholder: "Enter additional comments..." %></div>
  </div>

<% elsif field['type'] == "Button" %>
  <div class="relative inline-block w-full checkbox-button">
    <%= check_box_tag "form_fill[#{field['name']}]", 'Yes', field['value'] == 'Yes', { id: field_id, class: "hidden peer", required: field['required'] == true } %>
    <label for="<%= field_id %>" class="checkbox-button-label flex items-center justify-center text-center py-4 px-5 md:p-6 text-base md:text-lg font-semibold min-h-[60px] md:min-h-[70px] rounded-2xl cursor-pointer transition-all duration-300 ease-in-out shadow-md bg-gradient-to-br from-red-100 to-red-200 border-2 border-red-600 text-red-900 hover:from-red-200 hover:to-red-400 hover:border-red-700 hover:-translate-y-0.5 hover:shadow-lg peer-checked:from-red-600 peer-checked:to-red-700 peer-checked:border-red-900 peer-checked:text-white peer-checked:shadow-xl">
      <%= raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}") %>
    </label>
  </div>

<% elsif field['type'] == "Radio" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <%= hidden_field_tag "form_fill[#{field['name']}]", field['value'], id: "hidden_input_#{field_id}" %>
    <div class="radio-button-group space-y-3" data-controller="choice-buttons" data-hidden-input-id="hidden_input_<%= field_id %>">
      <% field['options'].each_with_index do |option, option_index| %>
        <% option_value = option.is_a?(Array) ? option.last : option %>
        <% option_label = option.is_a?(Array) ? option.first : option %>
        <% is_selected = field['value'] == option_value %>
          <button type="button" class="<%= radio_choice_button_classes(is_selected) %>" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="<%= option_value %>" data-selected="<%= is_selected ? 'true' : 'false' %>">
          <div class="radio-indicator w-5 h-5 rounded-full border-2 border-current mr-4 flex items-center justify-center flex-shrink-0">
            <div class="w-2.5 h-2.5 rounded-full bg-current transition-opacity duration-200 <%= is_selected ? 'opacity-100' : 'opacity-0' %>"></div>
          </div>
          <span class="flex-1 text-left"><%= option_label %></span>
        </button>
      <% end %>
    </div>
  </div>

<% elsif field['type'] == "Text" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative">
      <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
      <%= form.text_field field['name'], id: field_id, value: field['value'], required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20", placeholder: "Enter #{(field['label_name'].presence || field['name'])}" %>
    </div>
  </div>

<% elsif field['type'] == "Date" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative">
      <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      <%= form.date_field field['name'], id: field_id, value: field['value'].presence || Date.current.strftime("%Y-%m-%d"), data: { controller: "date-fix" }, required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" %>
    </div>
  </div>

<% elsif (field['type'] == "Choice") && field['options'].is_a?(Array) %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative">
      <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path></svg>
      <%= form.select field['name'], options_for_select(field['options'].map { |option| [option.is_a?(Array) ? option.first : option, option.is_a?(Array) ? option.last : option] }, field['value']), { include_blank: 'Select an option' }, id: field_id, required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md appearance-none bg-white/95 border-2 border-blue-800 text-blue-900 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" %>
    </div>
  </div>

<% else %>
  <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-6 shadow-lg">
    <div class="flex items-start space-x-3">
      <svg class="w-6 h-6 text-amber-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
      <div>
        <h4 class="text-amber-800 font-bold mb-2 text-lg"><%= raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}") %></h4>
        <p class="text-amber-700 text-sm mb-2">Type: <span class="font-mono font-semibold"><%= field['type'] %></span></p>
        <p class="text-amber-700 text-sm">This field type is not yet compatible with the web interface</p>
      </div>
    </div>
  </div>
<% end %>