<%# Partial para renderizar un campo individual del formulario %>
<%# --- Verificaciones iniciales --- %>
<% return unless local_assigns.key?(:field) && field.is_a?(Hash) && field.key?('name') && field['name'].present? %>
<% return unless local_assigns.key?(:form) %>
<% return unless local_assigns.key?(:field_id) %>
<%# --- Lógica de renderizado de campos --- %>
<% if field['type'] == "Pass/Fail" %>
  <div data-pagination-skip-trigger="true">
    <%= form.label field['name'],
        raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"),
        for: field_id,
        class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <%= hidden_field_tag "form_fill[#{field['name']}]", field['value'], id: "hidden_input_#{field_id}" %>
    <div class="choice-button-group" data-controller="choice-buttons" data-hidden-input-id="hidden_input_<%= field_id %>">
      <button type="button" class="choice-button" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="Pass">Pass</button>
      <button type="button" class="choice-button" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="Fail">Fail</button>
      <button type="button" class="choice-button" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="N/A">N/A</button>
    </div>
  </div>
<% elsif ['Photo', 'pass_photo'].include?(field['type']) %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class=\"text-red-400\">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    
    
    <!-- Controlador offline de fotos -->
    
    
    <% if ['Photo', 'pass_photo'].include?(field['type']) %>
    <% 
      btn_color = field['type'] == 'pass_photo' ? 'emerald' : 'red'
      btn_classes = "from-#{btn_color}-500 to-#{btn_color}-700 hover:from-#{btn_color}-600 hover:to-#{btn_color}-800 border-#{btn_color}-400"
    %>
    <div data-controller="offline-photo photo-capture"
         data-offline-photo-form-fill-id-value="<%= @form_fill.id %>"
         data-offline-photo-field-name-value="<%= field['name'] %>"
         data-photo-capture-input-id-value="<%= field_id %>"
         data-photo-capture-camera-input-id-value="<%= field_id %>_camera"
         data-photo-capture-field-name-value="<%= field['name'] %>">
      
      <%= form.file_field field['name'], id: field_id, accept: "image/*", class: "hidden", multiple: true,
            data: { action: 'change->offline-photo#handleFileSelect', offline_photo_target: 'input' } %>

      <%= form.file_field field['name'], id: "#{field_id}_camera", accept: "image/*", capture: "environment", class: "hidden",
            data: { action: 'change->offline-photo#handleFileSelect' } %>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <button type="button" data-action="click->photo-capture#openNativeCamera" class="w-full flex items-center justify-center bg-gradient-to-br <%= btn_classes %> text-white font-bold py-6 px-4 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl border-2">
          <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0118.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <span class="text-lg">Take Photo</span>
        </button>

        <button type="button" data-action="click->photo-capture#openCamera" class="w-full flex items-center justify-center bg-slate-700 hover:bg-slate-600 text-white font-bold py-6 px-4 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl border-2 border-slate-500">
          <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span class="text-lg">Gallery</span>
        </button>
      </div>

      <!-- Gallery of saved photos -->
      <div class="grid grid-cols-2 gap-4 mt-4 p-3" data-photo-capture-target="gallery">
        <% 
           existing_photos = @form_fill.get_photos_for_field(field['name'])
        %>
        <% existing_photos.each do |photo| %>
          <div class="relative bg-slate-700 rounded-2xl p-2 border-2 border-<%= btn_color %>-400 group photo-item" id="photo-<%= photo.filename.to_s.split('.').first %>">
            <%= image_tag rails_blob_path(photo), class: "w-full h-48 object-cover rounded-xl", alt: "Photo" %>
            <button type="button" 
                    class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full p-2 hover:bg-red-600 shadow-lg transform hover:scale-110 transition-all z-10"
                    data-action="click->photo-capture#removePhoto"
                    data-photo-id="<%= photo.filename.to_s.split('.').first %>"
                    title="Remove photo">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div class="absolute bottom-2 right-2 bg-black/50 text-white text-xs px-2 py-1 rounded-full">Saved</div>
          </div>
        <% end %>
      </div>
    </div>
    
    <% else %>
      <div class="form-field">
        <%= form.label field['name'], field['label'] %>
        <%= form.text_field field['name'], class: 'form-control' %>
      </div>
    <% end %>
  </div>
<% elsif ['Signature', 'Signature_Field', 'Signature_Annex'].include?(field['type']) %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class=\"text-red-400\">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>

    <div data-controller="signature-pad offline-photo"
         data-offline-photo-form-fill-id-value="<%= @form_fill.id %>"
         data-offline-photo-field-name-value="<%= field['name'] %>"
         data-offline-photo-kind-value="signature"
         data-offline-photo-accepted-types-value='["image/png","image/jpeg"]'
         data-stroke-width="<%= (field['signatureStrokeWidth'] || 2).to_s %>"
         data-stroke-color="<%= field['signatureStrokeColor'].presence || '#000000' %>"
         data-pad-height="<%= (field['signaturePadHeight'] || 200).to_s %>"
         data-field-name="<%= field['name'] %>">

      <div class="bg-slate-700 rounded-2xl p-4 border-2 border-blue-400">
        <div class="flex items-center justify-between mb-3">
          <span class="text-white font-semibold text-sm">
            <% if field['type'] == 'Signature_Annex' %>
              Client signature (annex page)
            <% else %>
              Technician signature (field)
            <% end %>
          </span>
          <div class="flex space-x-2">
            <button type="button" data-signature-pad-target="clearButton" data-action="click->signature-pad#clear" class="text-slate-300 hover:text-slate-200 transition-colors text-xs">Clear</button>
            <button type="button" data-signature-pad-target="saveButton" data-action="click->signature-pad#save" class="text-green-400 hover:text-green-300 transition-colors text-xs">Save</button>
          </div>
        </div>

        <canvas data-signature-pad-target="canvas" class="w-full bg-white rounded-xl border border-slate-600" height="<%= (field['signaturePadHeight'] || 200).to_s %>" style="touch-action: none;"></canvas>

        <input type="hidden" data-signature-pad-target="base64Input" id="signature_base64_<%= field_id %>">
        <input type="hidden" data-signature-pad-target="fieldName" value="<%= field['name'] %>">

        <div id="signature-preview-<%= field_id %>" data-offline-photo-target="preview" class="mt-4 <%= field['signature_attachment_id'].present? ? '' : 'hidden' %>">
          <div class="relative bg-slate-700 rounded-2xl p-4 border-2 border-blue-400">
            <div class="flex items-center justify-between mb-3">
              <span class="text-white font-semibold text-sm"><% if field['signature_attachment_id'].present? %>Saved signature:<% else %>Captured signature:<% end %></span>
              <div class="flex space-x-2">
                <button type="button" data-offline-photo-target="removeButton" data-action="click->offline-photo#handleRemoveConfirmed" data-turbo-confirm="¿Are you sure you want to delete?" class="text-red-400 hover:text-red-300 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
              </div>
            </div>

            <% if field['signature_attachment_id'].present? %>
              <% existing_signature = @form_fill.get_signature_for_field(field['name']) %>
              <% if existing_signature.present? %>
                <%= image_tag rails_blob_path(existing_signature), data: { offline_photo_target: "preview" }, class: "w-full object-contain rounded-xl border border-slate-600 bg-white", alt: "Signature for #{field['label_name'].presence || field['name']}" %>
              <% else %>
                <img data-offline-photo-target="preview" class="w-full object-contain rounded-xl border border-slate-600 bg-white" alt="Captured signature" src="">
              <% end %>
            <% else %>
              <img data-offline-photo-target="preview" class="w-full object-contain rounded-xl border border-slate-600 bg-white" alt="Captured signature" src="">
            <% end %>

            <div class="file-info text-xs text-slate-300 mt-2">
              <% if field['signature_attachment_id'].present? %>
                <div class="flex justify-between items-center"><span class="flex items-center"><svg class="w-3 h-3 mr-1 text-green-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg><%= field['label_name'].presence || field['name'] %></span><span class="text-green-400">Saved</span></div>
              <% else %>
                <div class="flex justify-between items-center"><span class="flex items-center"><svg class="w-3 h-3 mr-1 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414L9 13.414l4.707-4.707z" clip-rule="evenodd"></path></svg><%= field['label_name'].presence || field['name'] %></span><span class="text-yellow-400">Offline (pending)</span></div>
              <% end %>
            </div>
            <% if field['type'] == 'Signature_Annex' %>
              <div class="mt-2 text-xs text-slate-300">
                This signature will be attached as an additional page in the final PDF.
              </div>
            <% end %>
            <div data-offline-photo-target="status" class="photo-status"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% elsif field['type'] == "Deficiency" %>
          <div class="space-y-4" 
               data-controller="deficiency-list" 
               data-deficiency-list-default-item-value="<%= field['Item'] %>">
            <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    
    <%# Input hidden principal que almacena la colección JSON %>
    <% collection_value = field["#{field['name']}_collection"] %>
    <% collection_value = collection_value.to_json if collection_value.is_a?(Array) %>
    <%= form.hidden_field "#{field['name']}_collection", 
        id: "#{field_id}_collection", 
        value: collection_value || '[]',
        data: { deficiency_list_target: "input" } %>

    <%# List Container %>
    <div data-deficiency-list-target="listContainer">
      <%# Lista de deficiencias agregadas %>
      <div data-deficiency-list-target="list" class="space-y-3 mb-4">
        <!-- Renderizado por JS -->
      </div>

      <%# Botón para agregar nueva deficiencia %>
      <button type="button" 
              data-action="click->deficiency-list#showForm"
              class="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold shadow-lg transition-all flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Add Deficiency
      </button>
    </div>

    <%# Form Container (Replacing Modal) %>
    <div data-deficiency-list-target="formContainer" class="hidden bg-slate-800 rounded-2xl p-4 border border-slate-700 space-y-4 mt-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl leading-6 font-bold text-white" data-deficiency-list-target="formTitle">
          Add Deficiency
        </h3>
        <button type="button" data-action="click->deficiency-list#showList" class="bg-slate-800 rounded-md text-gray-400 hover:text-white focus:outline-none">
          <span class="sr-only">Close</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div class="space-y-4">
        <%# Item %>
        <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
            <input type="text" data-deficiency-list-target="modalItem" class="w-full rounded-2xl py-3 pl-14 pr-4 text-base font-medium bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" placeholder="Item..." value="<%= field['Item'] || '' %>">
        </div>

        <%# Riser %>
        <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path></svg>
            <input type="number" data-deficiency-list-target="modalRiser" class="w-full rounded-2xl py-3 pl-14 pr-4 text-base font-medium bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" placeholder="Riser Number..." value="<%= field['Riser'] || '' %>">
        </div>

        <%# Checkboxes C/D %>
        <div class="grid grid-cols-2 gap-4">
          <div class="relative inline-block w-full checkbox-button">
            <input type="checkbox" id="<%= field_id %>_modal_c" data-deficiency-list-target="modalC" class="hidden peer">
            <label for="<%= field_id %>_modal_c" class="checkbox-button-label flex items-center justify-center text-center py-3 px-4 font-semibold rounded-2xl cursor-pointer transition-all shadow-md bg-gradient-to-br from-blue-100 to-blue-200 border-2 border-blue-600 text-blue-900 peer-checked:from-blue-600 peer-checked:to-blue-700 peer-checked:border-blue-900 peer-checked:text-white">C</label>
          </div>
          <div class="relative inline-block w-full checkbox-button">
            <input type="checkbox" id="<%= field_id %>_modal_d" data-deficiency-list-target="modalD" class="hidden peer">
            <label for="<%= field_id %>_modal_d" class="checkbox-button-label flex items-center justify-center text-center py-3 px-4 font-semibold rounded-2xl cursor-pointer transition-all shadow-md bg-gradient-to-br from-red-100 to-red-200 border-2 border-red-600 text-red-900 peer-checked:from-red-600 peer-checked:to-red-700 peer-checked:border-red-900 peer-checked:text-white">D</label>
          </div>
        </div>

        <%# Searchable Select (Anidado) %>
        <div data-controller="searchable-select">
          <input type="hidden" data-deficiency-list-target="modalSelect" data-searchable-select-target="hiddenInput">
          
          <div class="relative">
            <button type="button" 
                    data-action="click->searchable-select#toggle" 
                    data-searchable-select-target="button" 
                    class="relative w-full rounded-2xl py-3 pl-4 pr-12 text-left text-base font-medium transition-all shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20">
              <span data-searchable-select-target="buttonText" data-deficiency-list-target="searchableSelectButtonText">Select an option</span>
              <button type="button" 
                      class="absolute inset-y-0 right-10 flex items-center px-2 text-sm text-blue-700 hover:text-blue-900 hover:bg-blue-50 rounded-md"
                      data-action="click->searchable-select#clear">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
              <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.53.22l3.5 3.5a.75.75 0 01-1.06 1.06L10 4.81 6.53 8.28a.75.75 0 01-1.06-1.06l3.5-3.5A.75.75 0 0110 3zm-3.72 9.28a.75.75 0 011.06 0L10 15.19l3.47-3.47a.75.75 0 111.06 1.06l-4 4a.75.75 0 01-1.06 0l-4-4a.75.75 0 010-1.06z" clip-rule="evenodd" /></svg>
              </span>
            </button>

            <div data-searchable-select-target="optionsContainer" class="hidden absolute z-20 mt-2 w-full bg-white rounded-2xl shadow-lg border border-blue-600 overflow-hidden">
              <div class="p-2">
                <input type="text" 
                       data-action="input->searchable-select#search" 
                       data-searchable-select-target="searchInput" 
                       placeholder="Search..." 
                       class="w-full rounded-lg py-2 px-3 text-base font-medium bg-slate-100 border-2 border-slate-300 text-slate-800 placeholder:text-slate-500 focus:bg-white focus:border-blue-600 focus:outline-none">
              </div>
              <ul data-searchable-select-target="optionsList" class="max-h-40 overflow-y-auto p-2">
                <% @deficiencies.each do |deficiency| %>
                  <li data-action="click->searchable-select#select" 
                      data-value="<%= deficiency.name %>" 
                      class="p-2 text-blue-900 rounded-lg cursor-pointer hover:bg-blue-100 transition-colors">
                    <%= deficiency.name %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>

        <%# Comment %>
        <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
            <input type="text" data-deficiency-list-target="modalComment" class="w-full rounded-2xl py-3 pl-14 pr-4 text-base font-medium bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" placeholder="Enter comments..." value="<%= field['comment_value'] || '' %>">
        </div>
      </div>

      <div class="mt-5 sm:mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 grid-flow-row-dense">
        <button type="button" data-action="click->deficiency-list#saveDeficiency" class="w-full inline-flex justify-center rounded-xl border border-transparent shadow-sm px-4 py-3 bg-blue-600 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:col-start-2 sm:text-sm">
          Save
        </button>
        <button type="button" data-action="click->deficiency-list#showList" class="mt-3 w-full inline-flex justify-center rounded-xl border border-gray-300 shadow-sm px-4 py-3 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:col-start-1 sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
<% elsif field['type'] == "Button" %>
  <div class="relative inline-block w-full checkbox-button">
    <%
      button_on_value = 'Yes'
      if field['options'].is_a?(Array) && field['options'].first.present?
        option = field['options'].first
        # Maneja ambos formatos de opción: string simple o array [label, value]
        button_on_value = option.is_a?(Array) ? option.last : option
      end

      # Determina si el botón debe estar marcado
      is_checked = field['value'] == button_on_value
    %>
    <%= check_box_tag "form_fill[#{field['name']}]", button_on_value, is_checked, { id: field_id, class: "hidden peer", required: field['required'] == true } %>
    <label for="<%= field_id %>" class="checkbox-button-label flex items-center justify-center text-center py-4 px-5 md:p-6 text-base md:text-lg font-semibold min-h-[60px] md:min-h-[70px] rounded-2xl cursor-pointer transition-all duration-300 ease-in-out shadow-md bg-gradient-to-br from-red-100 to-red-200 border-2 border-red-600 text-red-900 hover:from-red-200 hover:to-red-400 hover:border-red-700 hover:-translate-y-0.5 hover:shadow-lg peer-checked:from-red-600 peer-checked:to-red-700 peer-checked:border-red-900 peer-checked:text-white peer-checked:shadow-xl">
      <%= raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}") %>
    </label>
  </div>
<% elsif field['type'] == "Radio" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <%= hidden_field_tag "form_fill[#{field['name']}]", field['value'], id: "hidden_input_#{field_id}" %>
    <div class="radio-button-group space-y-3" data-controller="choice-buttons" data-hidden-input-id="hidden_input_<%= field_id %>">
      <% field['options'].each_with_index do |option, option_index| %>
        <% 
          # Determinar si la opción es un array [label, valor] o string simple
          if option.is_a?(Array) && option.length == 2
            option_label = option[0]  # Primer elemento es el label
            option_value = option[1]  # Segundo elemento es el valor
          else
            # Compatibilidad con formato anterior (string simple)
            option_label = option
            option_value = option
          end
          
          is_selected = field['value'] == option_value
        %>
        <button type="button" class="<%= radio_choice_button_classes(is_selected) %>" data-choice-buttons-target="button" data-action="click->choice-buttons#select" data-value="<%= option_value %>" data-selected="<%= is_selected ? 'true' : 'false' %>">
          <div class="radio-indicator w-5 h-5 rounded-full border-2 border-current mr-4 flex items-center justify-center flex-shrink-0">
            <div class="w-2.5 h-2.5 rounded-full bg-current transition-opacity duration-200 <%= is_selected ? 'opacity-100' : 'opacity-0' %>"></div>
          </div>
          <span class="flex-1 text-left"><%= option_label %></span>
        </button>
      <% end %>
    </div>
  </div>
<% elsif field['type'] == "Text" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative">
      <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
      <%= form.text_field field['name'], id: field_id, value: field['value'], required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20", placeholder: "Enter #{(field['label_name'].presence || field['name'])}" %>
    </div>
  </div>
<% elsif field['type'] == "Date" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative">
      <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      <% if field['section_name']&.starts_with?('Corrective Action Performed') %>
        <%= form.text_field field['name'], id: field_id, value: field['value'].presence, data: { controller: "datepicker" }, required: field['required'] == true, placeholder: "MM/DD/YYYY", pattern: "^(0[1-9]|1[0-2])/(0[1-9]|[12][0-9]|3[01])/[0-9]{4}$", autocomplete: "off", class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" %>
      <% else %>
        <%= form.text_field field['name'], id: field_id, value: field['value'].presence, data: { controller: "date-fix", "date-fix-auto-set": "on-focus" }, required: field['required'] == true, placeholder: "MM/DD/YY", pattern: "^(0[1-9]|1[0-2])/(0[1-9]|[12][0-9]|3[01])/[0-9]{2}$", autocomplete: "off", class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md bg-white/95 border-2 border-blue-800 text-blue-900 placeholder:text-blue-800/70 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" %>
      <% end %>
    </div>
  </div>
<% elsif (field['type'] == "Choice") && field['options'].is_a?(Array) %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="relative">
      <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"></path></svg>
      <%= form.select field['name'], options_for_select(field['options'].map { |option| 
        if option.is_a?(Array) && option.length == 2
          [option[0], option[1]]  # [label, valor]
        else
          [option, option]  # [label, valor] iguales para compatibilidad
        end
      }, field['value']), { include_blank: 'Select an option' }, id: field_id, required: field['required'] == true, class: "w-full rounded-2xl py-4 pl-14 pr-4 text-base lg:text-lg font-medium transition-all duration-200 shadow-md appearance-none bg-white/95 border-2 border-blue-800 text-blue-900 focus:bg-white focus:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-800/20" %>
    </div>
  </div>
<% elsif field['type'] == "System Category" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="space-y-4">
      <!-- Current Selection Display -->
      <% if field['value'].present? %>
        <div class="bg-purple-500/20 border border-purple-500/30 rounded-xl p-4">
          <div class="flex items-center space-x-3">
            <svg class="w-6 h-6 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <div class="text-purple-200 text-sm font-medium">Selected System Category:</div>
              <div class="text-white font-semibold"><%= field['value'] %></div>
            </div>
          </div>
        </div>
      <% end %>
      <!-- System Categories Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @system_categories.each do |category| %>
          <div class="relative">
            <%= form.radio_button field['name'], category.name, 
                checked: field['value'] == category.name,
                required: field['required'] == true,
                id: "#{field_id}_#{category.id}",
                class: "hidden peer" %>
            <label for="<%= "#{field_id}_#{category.id}" %>" 
                   class="group flex flex-col items-center justify-center text-center p-4 md:p-6 bg-slate-800/90 border border-white/10 rounded-2xl shadow-lg hover:bg-purple-600 hover:shadow-purple-500/50 transition-all duration-300 transform hover:-translate-y-1 cursor-pointer peer-checked:bg-purple-600 peer-checked:border-purple-400 peer-checked:shadow-purple-500/50">
              <% if category.thumbnail.attached? %>
                <%= image_tag category.thumbnail, 
                    alt: category.name,
                    class: "w-12 h-12 md:w-16 md:h-16 mb-3 object-contain" %>
              <% else %>
                <div class="w-12 h-12 md:w-16 md:h-16 mb-3 flex items-center justify-center bg-slate-700 rounded-full text-purple-300 text-2xl font-bold">
                  <%= category.name.first %>
                </div>
              <% end %>
              <span class="font-semibold text-white text-sm md:text-base group-hover:text-white">
                <%= category.name %>
              </span>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% elsif field['type'] == "Interval Category" %>
  <div>
    <%= form.label field['name'], raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}"), for: field_id, class: "block text-white font-bold text-base lg:text-lg mb-3" %>
    <div class="space-y-4">
      <!-- Current Selection Display -->
      <% selected_categories = field['selected_categories'] || (field['value'].present? ? field['value'].split(', ') : []) %>
      <% if selected_categories.any? %>
        <div class="bg-blue-500/20 border border-blue-500/30 rounded-xl p-4">
          <div class="flex items-start space-x-3">
            <svg class="w-6 h-6 text-blue-300 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <div>
              <div class="text-blue-200 text-sm font-medium mb-2">Selected Interval Categories:</div>
              <div class="flex flex-wrap gap-2">
                <% selected_categories.each do |category_name| %>
                  <span class="bg-blue-600 text-white px-3 py-1 rounded-full text-sm font-medium">
                    <%= category_name %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      <!-- Hidden field to store selected values -->
      <%= form.hidden_field field['name'], value: selected_categories.join(', '), id: "#{field_id}_hidden" %>
      <!-- Interval Categories List -->
      <div class="space-y-3">
        <% @interval_categories.each do |category| %>
          <div class="relative">
            <%= check_box_tag "#{field['name']}_categories[]", category.name,
                selected_categories.include?(category.name),
                id: "#{field_id}_#{category.id}",
                class: "hidden peer",
                data: { action: "change->form-fill#updateIntervalCategory" } %>
            <label for="<%= "#{field_id}_#{category.id}" %>" 
                   class="w-full text-left p-6 bg-slate-800/90 border border-white/10 rounded-xl shadow-lg hover:bg-blue-600/50 transition-all duration-200 flex items-center justify-between cursor-pointer peer-checked:bg-blue-600 peer-checked:border-blue-400">
              <span class="block text-white font-bold text-lg">
                <%= category.name %>
              </span>
              <div class="w-6 h-6 rounded-full border-2 flex-shrink-0 flex items-center justify-center transition-all duration-200 border-slate-500 peer-checked:bg-blue-600 peer-checked:border-blue-500">
                <svg class="w-4 h-4 text-white transition-opacity opacity-0 peer-checked:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-6 shadow-lg">
    <div class="flex items-start space-x-3">
      <svg class="w-6 h-6 text-amber-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
      <div>
        <h4 class="text-amber-800 font-bold mb-2 text-lg"><%= raw("#{field['label_name'].presence || field['name']} #{'<span class="text-red-400">*</span>'.html_safe if field['required'] == true}") %></h4>
        <p class="text-amber-700 text-sm mb-2">Type: <span class="font-mono font-semibold"><%= field['type'] %></span></p>
        <p class="text-amber-700 text-sm">This field type is not yet compatible with the web interface</p>
      </div>
    </div>
  </div>
<% end %>