<% @navigation_sections = navigation_sections_for_form(@form_fields) %>

<% content_for :head do %>
  <style>
    /* Estilos para campos de foto */
    .photo-field-container { transition: all 0.3s ease; }
    .photo-preview-container { animation: slideDown 0.3s ease-out; }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    .camera-button { position: relative; overflow: hidden; }
    .camera-button::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent); transition: left 0.5s; }
    .camera-button:hover::before { left: 100%; }
    .photo-preview img { transition: transform 0.2s ease; }
    .photo-preview img:hover { transform: scale(1.02); }
    .loading-state { opacity: 0.6; pointer-events: none; }
    .loading-spinner { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .file-status-saved { background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 0.5rem; padding: 0.25rem 0.5rem; }
    .file-status-new { background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 0.5rem; padding: 0.25rem 0.5rem; }
    @media (max-width: 768px) { .photo-preview img { height: 120px; } .camera-button { padding: 1rem; } .camera-button svg { width: 1.5rem; height: 1.5rem; } .camera-button span { font-size: 0.875rem; } }
    .photo-field-error { border-color: rgba(239, 68, 68, 0.5) !important; background: rgba(239, 68, 68, 0.05) !important; }
    .photo-field-success { border-color: rgba(34, 197, 94, 0.5) !important; background: rgba(34, 197, 94, 0.05) !important; }
    .photo-removing { animation: fadeOut 0.3s ease-out forwards; }
    @keyframes fadeOut { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(0.9); } }

    /* Estilos para el toggle */
    .additional-fields { max-height: 0; opacity: 0; overflow: hidden; transform: translateY(-10px); transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .additional-fields.show { max-height: 2000px; opacity: 1; transform: translateY(0); }
    .toggle-button { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); transition: all 0.3s ease; position: relative; overflow: hidden; }
    .toggle-button::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent); transition: left 0.5s; }
    .toggle-button:hover::before { left: 100%; }
    .toggle-button:hover { transform: translateY(-2px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
    .toggle-button.expanded { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
    .field-appear { animation: fieldAppear 0.6s ease-out forwards; }
    @keyframes fieldAppear { from { opacity: 0; transform: translateY(20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .icon-rotate { transition: transform 0.3s ease; }
    .icon-rotate.rotated { transform: rotate(180deg); }

    /* Estilos de validación y navegación */
    .validation-message { animation: slideInFromRight 0.3s ease-out; }
    @keyframes slideInFromRight { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
    .text-red-400 { color: #f87171; }
    button:disabled, .cursor-not-allowed { cursor: not-allowed; }
    button:disabled { opacity: 0.5; transform: none !important; }
    button:disabled:hover { transform: none !important; box-shadow: none !important; }

    .is-disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }
    .is-disabled:hover {
      transform: none !important;
    }

    /* Email button specific styles */
    .email-button-loading {
      opacity: 0.75;
      cursor: not-allowed;
      transform: none !important;
    }
    
    .email-button-loading:hover {
      transform: none !important;
      box-shadow: none !important;
    }
    
    .email-button-disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }
    
    .email-button-disabled:hover {
      transform: none !important;
      box-shadow: none !important;
    }

    /* Tooltip styles */
    .tooltip {
      z-index: 1000;
      pointer-events: none;
    }
    
    .tooltip-arrow {
      filter: drop-shadow(0 -1px 1px rgba(0, 0, 0, 0.1));
    }

    /* Estilos para el overlay de carga */
    .save-draft-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(8px);
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease-in-out;
    }

    .save-draft-overlay.show {
      opacity: 1;
      visibility: visible;
    }

    .save-draft-content {
      text-align: center;
      color: white;
      animation: pulseGlow 2s ease-in-out infinite;
    }

    .save-draft-logo {
      width: 120px;
      height: 120px;
      margin: 0 auto 2rem;
      animation: logoFloat 3s ease-in-out infinite;
      filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.3));
    }

    .save-draft-spinner {
      width: 60px;
      height: 60px;
      border: 4px solid rgba(255, 255, 255, 0.2);
      border-top: 4px solid #3b82f6;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 1.5rem auto;
    }

    .save-draft-text {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }

    .save-draft-subtext {
      font-size: 1rem;
      opacity: 0.8;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }

    @keyframes logoFloat {
      0%, 100% { transform: translateY(0px) scale(1); }
      50% { transform: translateY(-10px) scale(1.05); }
    }

    @keyframes pulseGlow {
      0%, 100% { text-shadow: 0 0 10px rgba(255, 255, 255, 0.5); }
      50% { text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(59, 130, 246, 0.5); }
    }
      box-shadow: none !important;
      background-color: #4A5568;
    }
  </style>
<% end %>
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900" data-controller="notification" data-action="show-notification@window->notification#showNotification">
  <div class="container mx-auto px-4 py-6 lg:pt-12 lg:pb-5">
    <%# --- HEADER --- %>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-4xl font-bold text-white mb-2"><%= @form_fill.name %></h1>
        <p class="text-blue-200 text-base md:text-lg">Complete all required fields to submit the inspection</p>
      </div>

      <%= link_to inspections_path, class: "inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl" do %>
        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span class="text-base lg:text-lg">Back to inspections</span>
      <% end %>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 pb-12">

    <div data-controller="page-navigation" data-page-navigation-pagination-outlet="#form-fill-main-form" class="w-[50%] mb-3.5">
      <select data-action="change->page-navigation#jump" class="w-full bg-slate-700 text-white font-semibold border-2 border-slate-500 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
        <option value="">Jump to a section...</option>
        <% @navigation_sections.each do |section| %>
          <%
            section_name = section[:name].humanize
            if section_name.downcase.include?('year') && section_name.include?('|') || section_name.downcase.include?('annual') && section_name.include?('|')
              section_name = section_name.split('|').last.strip
            end
          %>
          <option value="<%= section[:page] - 1 %>">
            Page <%= section[:page] %>: <%= section_name %>
          </option>
        <% end %>
      </select>
    </div>
    
    <div data-controller="field-toggle">
      <%= form_with model: @form_fill, url: form_fill_path(@form_fill), method: :patch, data: { controller: "pagination form-fill", turbo: false, "form-fill-form-structure-value": @form_fill.form_structure, "form-fill-form-fields-value": @form_fields.to_json, "form-fill-data-value": @form_fill.data.to_json, "form-fill-inspection-date-value": @inspection_date&.strftime("%m/%d/%Y") }, id: "form-fill-main-form", local: true, class: "space-y-8" do |form| %>
        <%= form.hidden_field :form_structure, id: 'form_fill_form_structure' %>
        <%= form.submit "Submit", class: "hidden" %>
        <% if @form_fields.blank? %>
          <div class="bg-red-50 border-2 border-red-200 rounded-3xl p-8">
            <p class="text-red-700 text-lg">No fields available in this form.</p>
          </div>
        <% else %>
          <% valid_fields = @form_fields.reject { |f| f['page_number'].to_i == 0 } %>
          <% pages = valid_fields.group_by { |f| f['page_number'].to_i }.sort_by { |page_num, _| page_num } %>
          <div class="relative z-10" data-pagination-target="pageContainer">
            <% pages.each_with_index do |(page_num, fields_on_page), page_index| %>
              <div class="page-content <%= page_index == 0 ? '' : 'hidden' %>" data-pagination-target="pageContent">
                <div class="bg-slate-800/95 backdrop-blur-sm rounded-3xl p-8 lg:p-10 border-2 border-blue-400 shadow-2xl">
                  <div class="mb-10">
                    <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3">Page <%= page_num %></h2>
                    <div class="w-20 h-2 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full"></div>
                  </div>
                  <% fields_on_page.group_by { |f| f['section_name'].presence || "General" }.each do |section_name, fields_in_section| %>
                    <div class="mb-10 last:mb-0">
                      <div class="flex items-center mb-8">
                        <div class="w-12 h-12 bg-blue-500 rounded-2xl flex items-center justify-center mr-4 shadow-lg"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></div>
                        <h3 class="text-white font-bold text-xl lg:text-2xl"><%= section_name.humanize %></h3>
                      </div>
                      <div class="grid grid-cols-1 md:grid-cols-9 gap-6 items-end">
                        <%
                          always_visible_types = ['Pass/Fail', 'Photo', 'Deficiency']
                          visible_fields = fields_in_section.select { |field| always_visible_types.include?(field['type']) || field['required'] == true }
                          hidden_fields = fields_in_section.reject { |field| always_visible_types.include?(field['type']) || field['required'] == true }
                        %>
                        <% visible_fields.each_with_index do |field, index| %>
                          <%
                            column_width_int = field['column_width'].to_i
                            column_span = column_width_int.in?(1..9) ? "custom-col-span-#{column_width_int}" : 'custom-col-span-3'
                          %>
                          <div class="<%= column_span %> space-y-4" data-field-type="<%= field['type'] %>" data-required="<%= field['required'] == true ? 'true' : 'false' %>" data-field-name="<%= field['name'] %>" data-section-name="<%= field['section_name'] %>">
                            <%= render partial: 'form_fills/form_field', locals: { form: form, field: field, field_id: "form_data_#{field['name'].parameterize.underscore}_#{section_name.parameterize.underscore}_#{index}" } %>
                          </div>
                        <% end %>
                        <% if hidden_fields.any? %>
                          <div class="md:col-span-9 mt-8">
                            <button type="button" data-action="click->field-toggle#toggleFields" data-field-toggle-target="toggleButton" class="toggle-button w-full py-4 px-6 rounded-2xl text-white font-bold text-lg shadow-lg flex items-center justify-center space-x-3">
                              <svg data-field-toggle-target="toggleIcon" class="w-6 h-6 icon-rotate" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                              <span data-field-toggle-target="toggleText">Show Additional Fields (<%= hidden_fields.length %>)</span>
                            </button>
                          </div>
                          <div class="md:col-span-9 additional-fields" data-field-toggle-target="additionalFields">
                            <div class="grid grid-cols-1 md:grid-cols-9 gap-6 items-end mt-6">
                              <% hidden_fields.each_with_index do |field, index| %>
                                <%
                                  column_width_int = field['column_width'].to_i
                                  column_span = column_width_int.in?(1..9) ? "custom-col-span-#{column_width_int}" : 'custom-col-span-3'
                                %>
                                <div class="<%= column_span %> space-y-4" data-field-type="<%= field['type'] %>" data-required="<%= field['required'] == true ? 'true' : 'false' %>" data-field-name="<%= field['name'] %>" data-section-name="<%= field['section_name'] %>">
                                  <%= render partial: 'form_fills/form_field', locals: { form: form, field: field, field_id: "form_data_#{field['name'].parameterize.underscore}_#{section_name.parameterize.underscore}_#{index}_additional" } %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
            <button type="button" data-action="click->pagination#backPage" data-pagination-target="backPageBtn" class="absolute top-1/2 -translate-y-1/2 z-10 w-[50px] h-[50px] md:w-[60px] md:h-[60px] rounded-full flex items-center justify-center transition-all duration-300 ease-in-out left-[-25px] md:left-[-30px] bg-slate-600 hover:bg-slate-700 text-white shadow-xl hover:shadow-2xl disabled:opacity-30 disabled:transform-none"><svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg></button>
            <button type="button" 
              data-action="click->pagination#nextPage" 
              data-pagination-target="nextPageBtn" 
              class="absolute top-1/2 -translate-y-1/2 z-10 w-[50px] h-[50px] md:w-[60px] md:h-[60px] rounded-full flex items-center justify-center transition-all duration-300 ease-in-out right-[-25px] md:right-[-30px] bg-blue-600 hover:bg-blue-700 text-white shadow-xl hover:shadow-2xl">
              <svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
          <div class="bg-slate-800/90 backdrop-blur-sm rounded-3xl mt-8 p-8 border-2 border-blue-400 animate-fade-in shadow-lg">
            <div class="flex items-start space-x-4 mb-6">
              <div class="w-12 h-12 bg-emerald-500 rounded-2xl flex items-center justify-center mt-1 shadow-lg"><svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
              <div>
                <h3 class="text-white font-bold text-xl mb-2">Form Actions</h3>
                <p class="text-blue-300 text-base mb-4">Save your progress or generate the final PDF</p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-4" 
                 data-controller="pdf-status" 
                 data-pdf-status-status-value="<%= @form_fill.pdf_generation_status %>"
                 data-pdf-status-refresh-interval-value="5000">
              <button type="button" data-controller="external-form-action" data-action="click->external-form-action#triggerSaveDraft" data-external-form-action-form-id-value="form-fill-main-form" class="inline-flex items-center justify-center bg-gradient-to-r from-blue-500 to-blue-700 hover:from-blue-600 hover:to-blue-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg"><svg class="w-5 h-5 mr-2 md:mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3-3m0 0l-3 3m3-3v12"></path></svg>Save Draft</button>
              <%# --- Botón Generate PDF con estado --- %>
              <% if @form_fill.generating? %>
                <div class="inline-flex items-center justify-center bg-gradient-to-r from-amber-500 to-amber-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg">
                  <svg class="w-5 h-5 mr-3 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                  </svg>
                  Generating PDF...
                </div>
              <% elsif @form_fill.failed? %>
                <div class="inline-flex items-center justify-center bg-gradient-to-r from-red-500 to-red-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg">
                  <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  PDF Generation Failed
                </div>
                <%= button_tag 'Retry Generate PDF', type: 'button', class: "inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg", data: { action: "click->form-fill#submitToPdf", confirm: "Are you sure you want to retry generating the PDF?" } %>
              <% else %>
                <%= button_tag 'Generate PDF', type: 'button', class: "inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg", data: { action: "click->form-fill#submitToPdf", confirm: "Are you sure you want to generate the PDF? This will finalize the form." } %>
              <% end %>
              <%# --- Botón para el PDF Principal --- %>
              <% if @form_fill.filled_pdf.attached? && @form_fill.completed? %>
                <a href="<%= download_pdf_form_fill_path(@form_fill, disposition: 'inline') %>" 
                  target="_blank" 
                  class="inline-flex items-center justify-center bg-gradient-to-r from-sky-500 to-sky-700 hover:from-sky-600 hover:to-sky-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  Ver PDF Principal
                </a>
              <% end %>
              <%# --- Lógica para encontrar y mostrar el PDF de Deficiencias --- %>
              <%
                # 1. Asegurarnos de que la inspección existe
                if @form_fill.inspection
                  # 2. Buscar la plantilla de deficiencias
                  deficiencies_template = FormTemplate.find_by(name: 'Deficiencies')
                  if deficiencies_template
                    # 3. Encontrar el form_fill de deficiencias asociado a la misma inspección
                    @deficiencies_form_fill = @form_fill.inspection.form_fills.find_by(form_template: deficiencies_template)
                  end
                end
              %>
              <%# --- Botón para el PDF de Deficiencias (solo si existe y tiene archivo) --- %>
              <% if @deficiencies_form_fill&.filled_pdf&.attached? %>
                <a href="<%= download_pdf_form_fill_path(@deficiencies_form_fill, disposition: 'inline') %>" 
                  target="_blank" 
                  class="inline-flex items-center justify-center bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
                  Ver PDF de Deficiencias
                </a>
              <% end %>
              
              <%# --- Email Button --- %>
              <% 
                # Check if PDF is available and customer has email
                pdf_available = @form_fill.filled_pdf.attached? && @form_fill.completed?
                customer_email_available = @form_fill.inspection&.property&.customer&.email.present?
                email_enabled = pdf_available && customer_email_available
              %>
              
              <% if email_enabled %>
                <div class="relative group">
                  <button type="button"
                          data-controller="email-sender"
                          data-action="click->email-sender#sendEmail"
                          data-email-sender-recipient-email-value="<%= @form_fill.inspection.property.customer.email %>"
                          data-email-sender-form-fill-id-value="<%= @form_fill.id %>"
                          data-email-sender-csrf-token-value="<%= form_authenticity_token %>"
                          class="inline-flex items-center justify-center bg-gradient-to-r from-purple-500 to-purple-700 hover:from-purple-600 hover:to-purple-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span data-email-sender-target="buttonText">Send Email</span>
                    <svg class="w-5 h-5 ml-2 animate-spin hidden" data-email-sender-target="spinner" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                  </button>
                  <!-- Tooltip showing recipient email -->
                  <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                    Send to: <%= @form_fill.inspection.property.customer.email %>
                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-800"></div>
                  </div>
                </div>
              <% elsif pdf_available && !customer_email_available %>
                <div class="inline-flex items-center justify-center bg-gray-500 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg opacity-50 cursor-not-allowed relative group">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  Email Unavailable
                  <!-- Tooltip -->
                  <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                    Customer email address not available
                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-800"></div>
                  </div>
                </div>
              <% elsif !pdf_available %>
                <div class="inline-flex items-center justify-center bg-gray-500 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg opacity-50 cursor-not-allowed relative group">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  PDF Required
                  <!-- Tooltip -->
                  <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                    Generate PDF first before sending email
                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-800"></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <!-- Overlay de carga para Save Draft -->
  <div id="save-draft-overlay" class="save-draft-overlay">
    <div class="save-draft-content">
      <%= image_tag "logo.png", alt: "Company Logo", class: "save-draft-logo" %>
      <div class="save-draft-spinner"></div>
      <div class="save-draft-text">Saving draft...</div>
      <div class="save-draft-subtext">Please wait, do not close this window</div>
    </div>
  </div>
</div>