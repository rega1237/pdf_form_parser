<% @navigation_sections = navigation_sections_for_form(@form_fields) %>

<% content_for :head do %>
  <style>
    /* Estilos para campos de foto */
    .photo-field-container { transition: all 0.3s ease; }
    .photo-preview-container { animation: slideDown 0.3s ease-out; }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    .camera-button { position: relative; overflow: hidden; }
    .camera-button::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent); transition: left 0.5s; }
    .camera-button:hover::before { left: 100%; }
    .photo-preview img { transition: transform 0.2s ease; }
    .photo-preview img:hover { transform: scale(1.02); }
    .loading-state { opacity: 0.6; pointer-events: none; }
    .loading-spinner { animation: spin 1s linear infinite; }
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .file-status-saved { background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 0.5rem; padding: 0.25rem 0.5rem; }
    .file-status-new { background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 0.5rem; padding: 0.25rem 0.5rem; }
    @media (max-width: 768px) { .photo-preview img { height: 120px; } .camera-button { padding: 1rem; } .camera-button svg { width: 1.5rem; height: 1.5rem; } .camera-button span { font-size: 0.875rem; } }
    .photo-field-error { border-color: rgba(239, 68, 68, 0.5) !important; background: rgba(239, 68, 68, 0.05) !important; }
    .photo-field-success { border-color: rgba(34, 197, 94, 0.5) !important; background: rgba(34, 197, 94, 0.05) !important; }
    .photo-removing { animation: fadeOut 0.3s ease-out forwards; }
    @keyframes fadeOut { from { opacity: 1; transform: scale(1); } to { opacity: 0; transform: scale(0.9); } }

    /* Estilos para el toggle */
    .additional-fields { max-height: 0; opacity: 0; overflow: hidden; transform: translateY(-10px); transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
    .additional-fields.show { max-height: 2000px; opacity: 1; transform: translateY(0); }
    .toggle-button { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); transition: all 0.3s ease; position: relative; overflow: hidden; }
    .toggle-button::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent); transition: left 0.5s; }
    .toggle-button:hover::before { left: 100%; }
    .toggle-button:hover { transform: translateY(-2px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
    .toggle-button.expanded { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); }
    .field-appear { animation: fieldAppear 0.6s ease-out forwards; }
    @keyframes fieldAppear { from { opacity: 0; transform: translateY(20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .icon-rotate { transition: transform 0.3s ease; }
    .icon-rotate.rotated { transform: rotate(180deg); }

    /* Estilos de validación y navegación */
    .validation-message { animation: slideInFromRight 0.3s ease-out; }
    @keyframes slideInFromRight { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
    .text-red-400 { color: #f87171; }
    button:disabled, .cursor-not-allowed { cursor: not-allowed; }
    button:disabled { opacity: 0.5; transform: none !important; }
    button:disabled:hover { transform: none !important; box-shadow: none !important; }

    .is-disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }
    .is-disabled:hover {
      transform: none !important;
    }

    /* Email button specific styles */
    .email-button-loading {
      opacity: 0.75;
      cursor: not-allowed;
      transform: none !important;
    }

    .email-button-loading:hover {
      transform: none !important;
      box-shadow: none !important;
    }

    .email-button-disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }

    .email-button-disabled:hover {
      transform: none !important;
      box-shadow: none !important;
    }

    /* Tooltip styles */
    .tooltip {
      z-index: 1000;
      pointer-events: none;
    }

    .tooltip-arrow {
      filter: drop-shadow(0 -1px 1px rgba(0, 0, 0, 0.1));
    }

    /* Estilos para el overlay de carga */
    .save-draft-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(15, 23, 42, 0.95);
      backdrop-filter: blur(8px);
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease-in-out;
    }

    .save-draft-overlay.show {
      opacity: 1;
      visibility: visible;
    }

    .save-draft-content {
      text-align: center;
      color: white;
      animation: pulseGlow 2s ease-in-out infinite;
    }

    .save-draft-logo {
      width: 120px;
      height: 120px;
      margin: 0 auto 2rem;
      animation: logoFloat 3s ease-in-out infinite;
      filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.3));
    }

    .save-draft-spinner {
      width: 60px;
      height: 60px;
      border: 4px solid rgba(255, 255, 255, 0.2);
      border-top: 4px solid #3b82f6;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 1.5rem auto;
    }

    .save-draft-text {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }

    .save-draft-subtext {
      font-size: 1rem;
      opacity: 0.8;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }

    @keyframes logoFloat {
      0%, 100% { transform: translateY(0px) scale(1); }
      50% { transform: translateY(-10px) scale(1.05); }
    }

    @keyframes pulseGlow {
      0%, 100% { text-shadow: 0 0 10px rgba(255, 255, 255, 0.5); }
      50% { text-shadow: 0 0 20px rgba(255, 255, 255, 0.8), 0 0 30px rgba(59, 130, 246, 0.5); }
    }

    /* Action Text / Trix Dark Mode Customizations */
    .trix-dark-mode trix-toolbar .trix-button-group {
      border-color: rgba(255, 255, 255, 0.15) !important;
      background-color: rgba(255, 255, 255, 0.05);
      border-radius: 6px;
      margin-bottom: 8px;
    }

    .trix-dark-mode trix-toolbar .trix-button {
      border-bottom-color: transparent !important;
      transition: all 0.2s ease;
    }

    .trix-dark-mode trix-toolbar .trix-button:not(:first-child) {
      border-left-color: rgba(255, 255, 255, 0.15) !important;
    }

    /* Invert icons to make them white */
    .trix-dark-mode trix-toolbar .trix-button::before {
      filter: invert(1) brightness(2);
      opacity: 0.7;
      transition: opacity 0.2s;
    }

    .trix-dark-mode trix-toolbar .trix-button:hover::before,
    .trix-dark-mode trix-toolbar .trix-button.trix-active::before {
      opacity: 1;
    }

    .trix-dark-mode trix-toolbar .trix-button:hover {
      background-color: rgba(255, 255, 255, 0.1) !important;
    }

    .trix-dark-mode trix-toolbar .trix-button.trix-active {
      background-color: rgba(147, 51, 234, 0.3) !important; /* Purple active state */
    }

    /* Hide file attach button if not needed or style it too */
    .trix-dark-mode trix-toolbar .trix-button--icon-attach {
      display: none !important;
    }
  </style>
<% end %>
<div class="min-h-screen" data-controller="notification" data-action="show-notification@window->notification#showNotification">
  <div class="container mx-auto px-4 py-6 lg:pt-12 lg:pb-5">
    <%# --- HEADER --- %>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-4xl font-bold text-white mb-2"><%= @form_fill.name %></h1>
        <p class="text-slate-300 text-base md:text-lg">Complete all required fields to submit the inspection</p>
      </div>

      <%= link_to inspections_path, class: "inline-flex items-center bg-white/10 hover:bg-white/15 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg hover:shadow-xl border border-white/20 backdrop-blur-sm" do %>
        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="text-base lg:text-lg">Back to inspections</span>
      <% end %>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 pb-12">

    <div data-controller="searchable-select page-navigation" data-page-navigation-pagination-outlet="#form-fill-main-form" class="w-[50%] mb-3.5 relative">
      <!-- Input oculto que guarda el valor seleccionado y dispara el salto de página -->
      <input type="hidden" data-searchable-select-target="hiddenInput" data-action="change->page-navigation#jump">

      <!-- Botón visible que abre/cierra el dropdown -->
      <button type="button" data-searchable-select-target="button" data-action="click->searchable-select#toggle"
        class="w-full bg-white/10 text-white font-semibold border border-white/20 rounded-lg py-2 px-4 flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-blue-500/60 focus:border-blue-500/60 transition backdrop-blur-sm">
        <span data-searchable-select-target="buttonText">Jump to a section...</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-300" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.25 8.29a.75.75 0 01-.02-1.08z" clip-rule="evenodd" />
        </svg>
      </button>

      <!-- Contenedor del dropdown con campo de búsqueda y lista -->
      <!-- Dropdown en overlay: no empuja el layout -->
      <div data-searchable-select-target="optionsContainer" class="hidden absolute top-full left-0 right-0 z-[1000] bg-slate-900/95 border border-white/20 rounded-lg shadow-xl w-full backdrop-blur-sm">
        <input type="text" data-searchable-select-target="searchInput" data-action="input->searchable-select#search" autocomplete="off"
               placeholder="Search sections..."
               class="w-full bg-white/5 text-white border-0 rounded-t-lg py-2 px-4 placeholder-slate-400 focus:outline-none">

        <ul data-searchable-select-target="optionsList" class="max-h-64 overflow-auto divide-y divide-white/10">
          <li class="py-2 px-4 text-slate-300">Jump to a section...</li>
          <% @navigation_sections.each do |section| %>
            <%
              full_name = section[:name]
              pipe_count = full_name.count('|')

              if pipe_count >= 2
                section_display_name = full_name
              elsif pipe_count == 1
                parts = full_name.split('|', 2).map(&:strip)
                # Extraer contenido entre paréntesis de la primera parte (ej. (I), (M), (T))
                parenthesis_match = parts[0].match(/\((.*?)\)/)
                parenthesis = parenthesis_match ? parenthesis_match[0] : nil
                
                target_text = parts[1]
                
                # Si hay paréntesis y el texto de destino empieza con un número (ej. 1.1)
                if parenthesis && target_text.match?(/^\d+(\.\d+)*(\s+|$)/)
                  # Insertar el paréntesis justo después del primer grupo de números
                  section_display_name = target_text.sub(/^(\d+(?:\.\d+)*)/, "\\1 #{parenthesis}")
                else
                  section_display_name = target_text
                end
              else
                section_display_name = full_name
              end
            %>
            <li data-action="click->searchable-select#select" data-value="<%= section[:page] - 1 %>"
                class="cursor-pointer py-2 px-4 hover:bg-white/10 text-white">
              Page <%= section[:page] %>: <%= section_display_name %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div data-controller="field-toggle">
      <%= form_with model: @form_fill, url: form_fill_path(@form_fill), method: :patch, data: { controller: "pagination form-fill", turbo: false, "form-fill-form-structure-value": @form_fill.form_structure, "form-fill-form-fields-value": @form_fields.to_json, "form-fill-data-value": @form_fill.data.to_json, "form-fill-inspection-date-value": @inspection_date&.strftime("%m/%d/%Y") }, id: "form-fill-main-form", local: true, class: "space-y-8" do |form| %>
        <%= form.hidden_field :form_structure, id: 'form_fill_form_structure' %>
        <%= form.submit "Submit", class: "hidden" %>
        <% if @form_fields.blank? %>
          <div class="bg-red-500/10 border border-red-500/30 rounded-3xl p-8">
            <p class="text-red-200 text-lg">No fields available in this form.</p>
          </div>
        <% else %>
          <% valid_fields = @form_fields.reject { |f| f['page_number'].to_i == 0 } %>
          <% pages = valid_fields.group_by { |f| f['page_number'].to_i }.sort_by { |page_num, _| page_num } %>
          <div class="relative z-10" data-pagination-target="pageContainer">
            <% pages.each_with_index do |(page_num, fields_on_page), page_index| %>
              <div class="page-content <%= page_index == 0 ? '' : 'hidden' %>" data-pagination-target="pageContent">
                <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 lg:p-10 border border-white/20 shadow-2xl">
                  <div class="mb-10">
                    <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3">Page <%= page_num %></h2>
                    <div class="w-20 h-2 bg-gradient-to-r from-blue-500 to-blue-600 rounded-full"></div>
                  </div>
                  <% fields_on_page.group_by { |f| f['section_name'].presence || "General" }.each do |section_name, fields_in_section| %>
                    <div class="mb-10 last:mb-0">
                      <div class="flex items-center mb-8">
                        <div class="w-12 h-12 bg-blue-500/20 border border-blue-400/30 rounded-2xl flex items-center justify-center mr-4 shadow-lg"><svg class="w-6 h-6 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg></div>
                        <h3 class="text-white font-bold text-xl lg:text-2xl"><%= section_name %></h3>
                      </div>
                      <div class="grid grid-cols-1 md:grid-cols-9 gap-6 items-end">
                          <%
                            always_visible_types = ['Pass/Fail', 'Photo', 'Deficiency', 'Radio']
                            always_visible_sections = ['Signature', 'Property Information', 'License', 'Corrective Action Performed']
                            always_visible_labels = ['PSI', 'Sec', 'Psi', 'SEC']
                            visible_fields = fields_in_section.select { |field| 
                              always_visible_types.include?(field['type']) || 
                              field['required'] == true || 
                              always_visible_sections.any? { |s| field['section_name'].to_s.include?(s) } ||
                              always_visible_labels.any? { |label| field['name'].to_s.include?(label) || field['label_name'].to_s.include?(label) }
                            }
                            hidden_fields = fields_in_section.reject { |field| 
                              always_visible_types.include?(field['type']) || 
                              field['required'] == true || 
                              always_visible_sections.any? { |s| field['section_name'].to_s.include?(s) } ||
                              always_visible_labels.any? { |label| field['name'].to_s.include?(label) || field['label_name'].to_s.include?(label) }
                            }
                          %>
                        <% visible_fields.each_with_index do |field, index| %>
                          <%
                            column_width_int = field['column_width'].to_i
                            column_span = column_width_int.in?(1..9) ? "custom-col-span-#{column_width_int}" : 'custom-col-span-3'
                          %>
                          <div class="<%= column_span %> space-y-4" data-field-type="<%= field['type'] %>" data-required="<%= field['required'] == true ? 'true' : 'false' %>" data-field-name="<%= field['name'] %>" data-section-name="<%= field['section_name'] %>">
                            <%= render partial: 'form_fills/form_field', locals: { form: form, field: field, field_id: "form_data_#{field['name'].parameterize.underscore}_#{section_name.parameterize.underscore}_#{index}" } %>
                          </div>
                        <% end %>
                        <% if hidden_fields.any? %>
                          <div class="md:col-span-9 mt-8">
                            <button type="button" data-action="click->field-toggle#toggleFields" data-field-toggle-target="toggleButton" class="toggle-button w-full py-4 px-6 rounded-2xl text-white font-bold text-lg shadow-lg flex items-center justify-center space-x-3">
                              <svg data-field-toggle-target="toggleIcon" class="w-6 h-6 icon-rotate" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                              <span data-field-toggle-target="toggleText">Show Additional Fields (<%= hidden_fields.length %>)</span>
                            </button>
                          </div>
                          <div class="md:col-span-9 additional-fields" data-field-toggle-target="additionalFields">
                            <div class="grid grid-cols-1 md:grid-cols-9 gap-6 items-end mt-6">
                              <% hidden_fields.each_with_index do |field, index| %>
                                <%
                                  column_width_int = field['column_width'].to_i
                                  column_span = column_width_int.in?(1..9) ? "custom-col-span-#{column_width_int}" : 'custom-col-span-3'
                                %>
                                <div class="<%= column_span %> space-y-4" data-field-type="<%= field['type'] %>" data-required="<%= field['required'] == true ? 'true' : 'false' %>" data-field-name="<%= field['name'] %>" data-section-name="<%= field['section_name'] %>">
                                  <%= render partial: 'form_fills/form_field', locals: { form: form, field: field, field_id: "form_data_#{field['name'].parameterize.underscore}_#{section_name.parameterize.underscore}_#{index}_additional" } %>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Finish Inspection button -->
            <div class="page-content hidden" data-pagination-target="pageContent">
              <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 lg:p-10 border border-red-500/30 shadow-2xl flex flex-col items-center justify-center h-full">
                <h2 class="text-3xl font-bold text-white mb-6">End of Inspection</h2>
                <p class="text-red-300 text-lg mb-8">Click the button below to finalize and return to the inspection summary.</p>
                <button type="button"
                        data-controller="inspection-status"
                        data-inspection-status-inspection-id-value="<%= @form_fill.inspection_id %>"
                        data-status="completed"
                        data-redirect="index"
                        data-action="click->inspection-status#updateStatus"
                        class="bg-red-600 hover:bg-red-700 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-lg text-xl">
                  End Inspection
                </button>
              </div>
            </div>

            <button type="button" data-action="click->pagination#backPage" data-pagination-target="backPageBtn" class="absolute top-1/2 -translate-y-1/2 z-10 w-[50px] h-[50px] md:w-[60px] md:h-[60px] rounded-full flex items-center justify-center transition-all duration-300 ease-in-out left-[-25px] md:left-[-30px] bg-white/10 hover:bg-white/20 text-white shadow-xl hover:shadow-2xl border border-white/20 disabled:opacity-30 disabled:transform-none backdrop-blur-sm"><svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg></button>
            <button type="button"
              data-action="click->pagination#nextPage"
              data-pagination-target="nextPageBtn"
              class="absolute top-1/2 -translate-y-1/2 z-10 w-[50px] h-[50px] md:w-[60px] md:h-[60px] rounded-full flex items-center justify-center transition-all duration-300 ease-in-out right-[-25px] md:right-[-30px] bg-blue-600/90 hover:bg-blue-700 text-white shadow-xl hover:shadow-2xl border border-blue-400/30 backdrop-blur-sm">
              <svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-3xl mt-8 p-8 border border-white/20 animate-fade-in shadow-lg relative z-20">
              <div class="flex items-start space-x-4 mb-6">
                <div class="w-12 h-12 bg-emerald-500/20 border border-emerald-400/30 rounded-2xl flex items-center justify-center mt-1 shadow-lg"><svg class="w-6 h-6 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                <div>
                  <h3 class="text-white font-bold text-xl mb-2">Form Actions</h3>
                  <p class="text-slate-300 text-base mb-4">Save your progress or generate the final PDF</p>
                  <% if @form_fill.last_generated_at.present? %>
                    <p class="text-slate-400 text-sm italic mb-4">Last generated: <%= l @form_fill.last_generated_at.in_time_zone("Pacific Time (US & Canada)"), format: :long %></p>
                  <% end %>
                </div>
              </div>
              <!-- Sync Button and Status -->
              <div class="inline-flex items-center mb-4" data-controller="sync">
                <button data-action="click->sync#startSync"
                        data-sync-target="syncButton"
                        class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-2xl transition-all duration-200 backdrop-blur-sm border border-white/10 hover:scale-105 flex items-center">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                  </svg>
                  Sync (<span data-sync-target="syncCount">0</span>)
                </button>
                <div data-sync-target="syncStatus" class="ml-4 hidden">
                  <div class="w-32 bg-white/10 rounded-full h-2 border border-white/10">
                    <div data-sync-target="progressBar" class="bg-orange-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                  </div>
                  <div data-sync-target="progressText" class="text-xs text-slate-300 mt-1">Syncing...</div>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-4"
                 data-controller="pdf-status"
                 data-pdf-status-status-value="<%= @form_fill.pdf_generation_status %>"
                 data-pdf-status-refresh-interval-value="5000">
              <%# --- Botón Generate PDF con estado --- %>
              <% if @form_fill.generating? && @form_fill.updated_at > 3.minutes.ago %>
                <div class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg">
                  <svg class="w-5 h-5 mr-3 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                  </svg>
                  Generating PDF...
                </div>
              <% elsif @form_fill.failed? %>
                <div class="inline-flex items-center justify-center bg-gradient-to-r from-red-500 to-red-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg">
                  <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  PDF Generation Failed
                </div>
                <%= button_tag 'Retry Generate PDF', type: 'button', style: "touch-action: manipulation; -webkit-tap-highlight-color: transparent; pointer-events: auto;", class: "relative z-50 inline-flex items-center justify-center bg-white hover:bg-slate-100 text-slate-900 font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 focus:ring-offset-slate-800", data: { controller: 'online-only', online_only_offline_title_value: 'Necesitas conexión a internet para generar el PDF', action: "touchstart->form-fill#submitToPdf click->form-fill#submitToPdf", confirm: "Are you sure you want to retry generating the PDF?" }, aria: { label: "Retry Generate PDF" } %>
              <% else %>
                <%= button_tag 'Generate PDF', type: 'button', style: "touch-action: manipulation; -webkit-tap-highlight-color: transparent; pointer-events: auto;", class: "relative z-50 inline-flex items-center justify-center bg-white hover:bg-slate-100 text-slate-900 font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 focus:ring-offset-slate-800", data: { controller: 'online-only', online_only_offline_title_value: 'Necesitas conexión a internet para generar el PDF', action: "touchstart->form-fill#submitToPdf click->form-fill#submitToPdf", confirm: "Are you sure you want to generate the PDF? This will finalize the form." }, aria: { label: "Generate PDF" } %>
              <% end %>

              <%# --- Botón para ir al formulario principal --- %>
              <% if @main_form_fill.present? && @form_fill != @main_form_fill %>
                <%= link_to 'Go to Main Form', form_fill_path(@main_form_fill),
                  class: 'inline-flex items-center justify-center bg-gradient-to-r from-blue-500 to-blue-700 hover:from-blue-600 hover:to-blue-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg' %>
              <% end %>

              <%# --- Botón Additional Risers --- %>
              <% if @additional_risers_form_fill.present? && @additional_risers_form_fill != @form_fill %>
                <%= link_to 'Additional Risers', form_fill_path(@additional_risers_form_fill),
                  class: 'inline-flex items-center justify-center bg-gradient-to-r from-slate-500 to-slate-700 hover:from-slate-600 hover:to-slate-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg' %>
              <% end %>

              <%# --- Botón Corrected Deficiencies --- %>
              <% if @corrections_form_fill.present? && @corrections_form_fill != @form_fill %>
                <%= link_to 'Corrected Deficiencies', form_fill_path(@corrections_form_fill),
                  class: 'inline-flex items-center justify-center bg-gradient-to-r from-yellow-400 to-yellow-600 hover:from-yellow-500 hover:to-yellow-700 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg' %>
              <% end %>

              <%# --- Botón para el PDF Principal --- %>
              <% if @form_fill.filled_pdf.attached? && @form_fill.completed? %>
                <a href="<%= download_pdf_form_fill_path(@form_fill, disposition: 'inline') %>"
                  target="_blank"
                  class="inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  View Main PDF
                </a>
              <% end %>
              <%# --- Lógica para encontrar y mostrar el PDF de Deficiencias --- %>
              <%
                # 1. Asegurarnos de que la inspección existe
                if @form_fill.inspection
                  # 2. Buscar la plantilla de deficiencias
                  deficiencies_template = FormTemplate.find_by(name: 'Deficiencies')
                  if deficiencies_template
                    # 3. Encontrar el form_fill de deficiencias asociado a la misma inspección
                    @deficiencies_form_fill = @form_fill.inspection.form_fills.find_by(form_template: deficiencies_template)
                  end
                end
              %>
              <%# --- Botón para el PDF de Deficiencias (solo si existe y tiene archivo) --- %>
              <% if @deficiencies_form_fill&.filled_pdf&.attached? %>
                <a href="<%= download_pdf_form_fill_path(@deficiencies_form_fill, disposition: 'inline') %>"
                  target="_blank"
                  class="inline-flex items-center justify-center bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
                  View Deficiencies PDF
                </a>
              <% end %>

              <%# --- Email Button --- %>
              <%
                # Check if PDF is available and customer has email
                pdf_available = @form_fill.filled_pdf.attached? && @form_fill.completed?
                customer_email_available = @form_fill.inspection&.property&.customer&.email.present?
                email_enabled = pdf_available && customer_email_available
              %>

              <% if email_enabled %>
                <div data-controller="email-sender"
                     data-email-sender-recipient-email-value="<%= @form_fill.inspection.property.customer.customer_emails.pluck(:address).join(', ') %>"
                     data-email-sender-form-fill-id-value="<%= @form_fill.id %>"
                     data-email-sender-csrf-token-value="<%= form_authenticity_token %>">
                  
                  <!-- Trigger Button -->
                  <button type="button"
                          data-action="click->email-sender#openModal"
                          class="inline-flex items-center justify-center bg-gradient-to-r from-blue-400 to-blue-600 hover:from-blue-500 hover:to-blue-700 text-white font-bold py-4 px-8 rounded-2xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg text-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <span>Send Email</span>
                  </button>

                  <!-- Modal Template -->
                  <template data-email-sender-target="template">
                    <div class="fixed inset-0" style="z-index: 99999;" aria-labelledby="modal-title" role="dialog" aria-modal="true">
                      <!-- Background backdrop -->
                      <div class="fixed inset-0 bg-gray-900/75 transition-opacity backdrop-blur-sm" aria-hidden="true"></div>

                      <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
                      <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
                        <div class="relative transform overflow-hidden rounded-2xl bg-slate-800 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-2xl border border-white/10">
                            
                            <!-- Header -->
                            <div class="bg-slate-900/50 px-4 py-4 sm:px-6 border-b border-white/10 flex justify-between items-center">
                              <h3 class="text-xl font-semibold leading-6 text-white" id="modal-title">Compose Email</h3>
                              <button type="button" data-action="close" class="text-slate-400 hover:text-white transition-colors">
                                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                              </button>
                            </div>

                            <!-- Form Content -->
                            <div class="px-4 py-5 sm:p-6 space-y-4">
                              <!-- Recipient -->
                              <div>
                                <label class="block text-sm font-medium text-slate-300 mb-1">To (comma separated)</label>
                                <div class="relative">
                                  <input type="text" 
                                         name="recipient_email" 
                                         class="block w-full rounded-lg p-2 bg-slate-700/50 border-white/10 text-white placeholder-slate-400 focus:ring-purple-500 focus:border-purple-500 sm:text-sm"
                                         value="<%= @form_fill.inspection.property.customer.customer_emails.pluck(:address).join(', ') %>"
                                         placeholder="email1@example.com, email2@example.com">
                                  <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                                    <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                  </div>
                                </div>
                                <p class="mt-1 text-xs text-slate-400">Separate multiple emails with commas</p>
                              </div>

                              <!-- Subject -->
                              <div>
                                <label for="email-subject" class="block text-sm font-medium text-slate-300 mb-1">Subject</label>
                                <input type="text" id="email-subject" name="subject"
                                       class="block w-full rounded-lg p-2 bg-slate-700/50 border-white/10 text-white placeholder-slate-400 focus:ring-purple-500 focus:border-purple-500 sm:text-sm"
                                       value="Inspection Report for <%= @form_fill.inspection.property.property_name %> - <%= @form_fill.inspection.date.strftime('%B %d, %Y') %>">
                              </div>

                              <!-- Attachment Info -->
                              <div class="flex items-center space-x-2 text-sm text-slate-400 bg-slate-700/30 p-2 rounded-lg border border-white/5">
                                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0111.414 3.414L15.586 7.586A2 2 0 0116 9.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                                </svg>
                                <span>Attachment: <strong><%= @form_fill.filled_pdf.filename %></strong></span>
                              </div>

                              <!-- Body (Trix Editor) -->
                              <div class="trix-dark-mode">
                                <label class="block text-sm font-medium text-slate-300 mb-1">Message</label>
                                <% default_body = "Dear #{@form_fill.inspection.property.customer.name},<br><br>Please find attached a copy of the inspection report for <strong>#{@form_fill.inspection.property.property_name}</strong>.<br><br>This report contains the complete inspection documentation including all findings and any deficiencies identified during the inspection process.<br><br>Thank you for choosing our inspection services.".html_safe %>
                                <%= rich_text_area_tag 'email_body', default_body, 
                                    class: "bg-white text-slate-900 rounded-lg min-h-[200px]" %>
                              </div>
                            </div>

                            <!-- Footer Actions -->
                            <div class="bg-slate-900/50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 border-t border-white/10">
                              <button type="button" 
                                      data-action="send"
                                      class="inline-flex w-full justify-center rounded-lg bg-purple-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-purple-500 sm:ml-3 sm:w-auto transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                </svg>
                                Send Email
                              </button>
                              <button type="button" 
                                      data-action="close"
                                      class="mt-3 inline-flex w-full justify-center rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold text-white shadow-sm ring-1 ring-inset ring-white/10 hover:bg-white/20 sm:mt-0 sm:w-auto transition-colors">
                                Cancel
                              </button>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </template>
                </div>
              <% elsif pdf_available && !customer_email_available %>
                <div class="inline-flex items-center justify-center bg-gray-500 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg opacity-50 cursor-not-allowed relative group">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  Email Unavailable
                  <!-- Tooltip -->
                  <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                    Customer email address not available
                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-800"></div>
                  </div>
                </div>
              <% elsif !pdf_available %>
                <div class="inline-flex items-center justify-center bg-gray-500 text-white font-bold py-4 px-8 rounded-2xl shadow-lg text-lg opacity-50 cursor-not-allowed relative group">
                  <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  PDF Required
                  <!-- Tooltip -->
                  <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-white text-sm rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10">
                    Generate PDF first before sending email
                    <div class="absolute top-full left-1/2 transform -translate-x-1/2 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-gray-800"></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
  <!-- Loading overlay for Save Draft -->
  <div id="save-draft-overlay" class="save-draft-overlay">
    <div class="save-draft-content">
      <%= image_tag "logo.png", alt: "Company Logo", class: "save-draft-logo" %>
      <div class="save-draft-spinner"></div>
      <div class="save-draft-text">Saving draft...</div>
      <div class="save-draft-subtext">Please wait, do not close this window</div>
    </div>
  </div>
</div>
<style>
  /* Toast de estado para fotos/firmas */
  .photo-status {
    margin-top: 6px;
    font-size: 12px;
    line-height: 1.2;
    color: #e2e8f0; /* slate-200 */
    display: flex;
    align-items: center;
    min-height: 20px;
    transition: opacity 0.2s ease;
  }
  .photo-status::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    margin-right: 6px;
    background: #64748b; /* slate-500 default */
  }
  .photo-status.photo-status--success { color: #86efac; /* green-300 */ }
  .photo-status.photo-status--success::before { background: #22c55e; }
  .photo-status.photo-status--error { color: #fca5a5; /* red-300 */ }
  .photo-status.photo-status--error::before { background: #ef4444; }
  .photo-status.photo-status--info { color: #93c5fd; /* blue-300 */ }
  .photo-status.photo-status--info::before { background: #3b82f6; }
</style>
