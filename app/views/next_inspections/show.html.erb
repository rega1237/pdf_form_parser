<% content_for :head do %>
  <style>
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideUp {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.6s ease-in-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
    .info-card {
      transition: all 0.3s ease;
    }
    .info-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    }
  </style>
<% end %>

<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <div class="flex items-center space-x-3 mb-2">
          <div class="w-10 h-10 bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <h1 class="text-2xl lg:text-3xl font-bold text-white">Inspection Details</h1>
        </div>
        <p class="text-slate-300 text-sm lg:text-base">Review upcoming inspection information</p>
      </div>
      <%= link_to next_inspections_path, class: "inline-flex items-center bg-slate-700/50 hover:bg-slate-600/50 text-white px-4 py-2 rounded-xl transition-all duration-200 backdrop-blur-sm border border-white/10 hover:scale-105" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to List
      <% end %>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto">
      <!-- Schedule Status Card -->
      <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl mb-8 animate-slide-up">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
          <div class="mb-6 lg:mb-0">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-12 h-12 bg-blue-500/20 rounded-2xl flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-white font-bold text-xl lg:text-2xl">Scheduled Inspection</h2>
                <p class="text-slate-300 text-sm lg:text-base">
                  <%= @next_inspection.next_inspection_date.strftime("%A, %B %d, %Y") %>
                </p>
              </div>
            </div>
            
            <% days_until = (@next_inspection.next_inspection_date - Date.current).to_i %>
            <% if days_until < 0 %>
              <div class="inline-flex items-center bg-red-500/20 text-red-300 px-4 py-2 rounded-xl border border-red-500/30">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="font-semibold"><%= pluralize(days_until.abs, 'day') %> overdue</span>
              </div>
            <% elsif days_until == 0 %>
              <div class="inline-flex items-center bg-amber-500/20 text-amber-300 px-4 py-2 rounded-xl border border-amber-500/30">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="font-semibold">Due Today</span>
              </div>
            <% else %>
              <div class="inline-flex items-center bg-emerald-500/20 text-emerald-300 px-4 py-2 rounded-xl border border-emerald-500/30">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="font-semibold">In <%= pluralize(days_until, 'day') %></span>
              </div>
            <% end %>
          </div>
          
          <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-3">
            <%= button_to create_inspection_from_next_next_inspection_path(@next_inspection), method: :post, class: "inline-flex items-center justify-center bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              Create Inspection Now
            <% end %>
          </div>
        </div>
      </div>

      <!-- Information Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Property Information -->
        <div class="info-card bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20 shadow-lg animate-slide-up" style="animation-delay: 0.1s;">
          <div class="flex items-center space-x-3 mb-6">
            <div class="w-10 h-10 bg-emerald-500/20 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
              </svg>
            </div>
            <h3 class="text-white font-bold text-lg">Property & Customer</h3>
          </div>
          
          <div class="space-y-4">
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <p class="text-slate-300 text-sm font-medium mb-1">Property Name</p>
              <p class="text-white font-semibold text-lg"><%= @next_inspection.property.property_name %></p>
            </div>
            
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <p class="text-slate-300 text-sm font-medium mb-1">Address</p>
              <p class="text-white"><%= @next_inspection.property.address %></p>
            </div>
            
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <p class="text-slate-300 text-sm font-medium mb-1">Customer</p>
              <p class="text-white font-semibold"><%= @next_inspection.property.customer.name %></p>
            </div>
          </div>
        </div>

        <!-- Inspection Plan -->
        <div class="info-card bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20 shadow-lg animate-slide-up" style="animation-delay: 0.2s;">
          <div class="flex items-center space-x-3 mb-6">
            <div class="w-10 h-10 bg-indigo-500/20 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
              </svg>
            </div>
            <h3 class="text-white font-bold text-lg">Inspection Plan</h3>
          </div>
          
          <div class="space-y-4">
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <p class="text-slate-300 text-sm font-medium mb-1">System Category</p>
              <p class="text-white font-semibold text-lg"><%= @next_inspection.system_category['name'] %></p>
            </div>
            
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <p class="text-slate-300 text-sm font-medium mb-2">Inspection Interval</p>
              <span class="inline-block bg-indigo-500/20 text-indigo-300 font-semibold px-4 py-2 rounded-xl border border-indigo-500/30">
                <%= @next_inspection.interval_category['name'] %>
              </span>
            </div>
            
            <div class="bg-white/5 rounded-xl p-4 border border-white/10">
              <p class="text-slate-300 text-sm font-medium mb-2">Current Status</p>
              <span class="inline-block bg-<%= @next_inspection.status == 'pending' ? 'amber' : 'emerald' %>-500/20 text-<%= @next_inspection.status == 'pending' ? 'amber' : 'emerald' %>-300 font-semibold px-4 py-2 rounded-xl border border-<%= @next_inspection.status == 'pending' ? 'amber' : 'emerald' %>-500/30 capitalize">
                <%= @next_inspection.status %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Information -->
      <% if @next_inspection.notes.present? %>
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 animate-fade-in">
          <div class="flex items-start space-x-3">
            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mt-1">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-2">Additional Notes</h3>
              <p class="text-slate-300 text-sm"><%= @next_inspection.notes %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>