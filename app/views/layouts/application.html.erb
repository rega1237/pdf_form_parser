<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Aes Fire Inspections" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- PWA Meta Tags -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="AES Fire Inspections">
    <meta name="application-name" content="AES Fire Inspections">
    <meta name="msapplication-TileColor" content="#1e293b">
    <meta name="theme-color" content="#1e293b">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- PWA Manifest -->
    <link rel="manifest" href="/manifest.json">
    <!-- PWA Icons -->
    <link rel="icon" type="image/png" sizes="100x100" href="/icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon_192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/icon_512.png">
    <link rel="apple-touch-icon" sizes="192x192" href="/icon_192.png">
    <!-- Estilos para header/footer global -->
    <style>
      /* Asegurar que el body tenga el fondo correcto */
      body {
        min-height: 100vh;
        background: linear-gradient(135deg, #000000 0%, #1e293b 50%, #000000 100%);
      }

      /* Estructura flex para sticky footer */
      .app-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .main-content {
        flex: 1;
      }
    </style>
    <%= yield :head %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gradient-to-br from-black-900 via-black-800 to-black-900" data-controller="pwa" data-pwa-debug-value="true">
    <!-- Global hidden controllers to ensure online/offline detection and auto-sync on every page -->
    <div class="hidden" data-controller="offline-status sync">
      <!-- Optional targets for offline-status (UI not displayed here) -->
      <div data-offline-status-target="indicator"></div>
      <span data-offline-status-target="text"></span>
      <!-- Optional targets for sync (UI not displayed here) -->
      <div data-sync-target="syncStatus" class="hidden">
        <div data-sync-target="progressBar"></div>
        <div data-sync-target="progressText"></div>
      </div>
      <button data-sync-target="syncButton" class="hidden" aria-hidden="true"></button>
      <span data-sync-target="syncCount" class="hidden" aria-hidden="true"></span>
    </div>
    <div class="app-container">
      <!-- Header Global -->
      <% unless controller_name == 'form_fills' && action_name == 'show' %>
        <header class="sticky top-0 z-50" data-controller="mobile-menu">
          <div class="bg-black/50 backdrop-blur-md border-b border-white/20 ">
            <div class="container mx-auto px-4 py-4">
              <div class="flex items-center justify-between">
                <!-- Logo and title -->
                <%= link_to root_path, class: "flex items-center space-x-3 hover:opacity-80 transition-opacity" do %>
                  <div class="w-50 flex items-center justify-center animate-bounce-subtle">
                    <img src="<%= asset_path('logo.png') %>" alt="">
                  </div>
                  <h1 class="text-xl lg:text-2xl font-bold text-white tracking-tight hidden">
                    AES <span class="text-blue-400">PRO </span>
                  </h1>
                <% end %>
                <!-- Mobile navigation - Hamburger menu -->
                <div class="lg:hidden">
                  <button data-action="click->mobile-menu#toggle" class="text-white p-2 rounded-lg hover:bg-white/10 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                  </button>
                </div>
                <!-- Desktop navigation -->
                <div class="hidden lg:flex items-center space-x-6">
                  <nav class="flex space-x-6">
                    <% if policy(FormTemplate).index? %>
                      <%= link_to "Library", form_templates_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                    <% end %>
                    <%= link_to "Inspections forms", form_fills_path, class: "hidden text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                    <% if policy(Customer).index? %>
                      <%= link_to "Customers", customers_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                    <% end %>
                    <%= link_to "Inspections", inspections_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                    <%= link_to "Next Inspections", next_inspections_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                    <% if policy(:company_settings).index? %>
                      <%= link_to "Settings", settings_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                    <% end %>
                  </nav>
                  <!-- User Profile Desktop -->
                  <% if current_user %>
                    <div class="flex items-center space-x-3 text-white bg-white/5 px-4 py-2 rounded-xl border border-white/20">
                      <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-white/30 shadow-lg">
                        <% if current_user.avatar.present? %>
                          <%= image_tag current_user.avatar, alt: "User Avatar", class: "w-full h-full object-cover" %>
                        <% else %>
                          <div class="w-full h-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center">
                            <svg class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                          </div>
                        <% end %>
                      </div>
                      <div class="hidden xl:block">
                        <p class="text-sm font-medium text-white"><%= current_user.email %></p>
                        <div class="flex items-center space-x-3 text-xs">
                          <%= link_to "Edit Profile", edit_user_registration_path, class: "text-blue-400 hover:text-blue-300 transition-colors duration-200" %>
                          <span class="text-slate-500">•</span>
                          <%= link_to destroy_user_session_path, method: :delete, class: "text-red-400 hover:text-red-300 transition-colors duration-200" do %>
                            <span>Sign Out</span>
                          <% end %>
                        </div>
                      </div>
                      <!-- Mobile/Smaller screens - Just icons -->
                      <div class="xl:hidden flex items-center space-x-2">
                        <%= link_to edit_user_registration_path, class: "text-slate-300 hover:text-white transition-colors duration-200" do %>
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          </svg>
                        <% end %>
                        <%= link_to destroy_user_session_path, method: :delete, class: "text-slate-300 hover:text-red-400 transition-colors duration-200" do %>
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                          </svg>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
              <!-- Mobile navigation - Dropdown menu -->
              <nav data-mobile-menu-target="menu" class="lg:hidden mt-4 hidden">
                <div class="flex flex-col space-y-2">
                  <!-- User Info Section Mobile -->
                  <% if current_user %>
                    <div class="bg-white/5 backdrop-blur-sm rounded-xl p-4 mb-4 border border-white/10">
                      <div class="flex items-center space-x-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-white/30">
                          <% if current_user.avatar.present? %>
                            <%= image_tag current_user.avatar, alt: "User Avatar", class: "w-full h-full object-cover" %>
                          <% else %>
                            <div class="w-full h-full bg-gradient-to-br from-slate-600 to-slate-700 flex items-center justify-center">
                              <svg class="w-6 h-6 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                              </svg>
                            </div>
                          <% end %>
                        </div>
                        <div class="flex-1">
                          <p class="text-white font-medium text-sm"><%= current_user.email %></p>
                          <p class="text-slate-400 text-xs">Inspector</p>
                        </div>
                        <%= link_to edit_user_registration_path, class: "text-slate-300 hover:text-white" do %>
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                          </svg>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                  <!-- Useful links -->
                  <% if policy(FormTemplate).index? %>
                    <%= link_to "Library", form_templates_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                  <% end %>
                  <%= link_to "Inspections forms", form_fills_path, class: "hidden text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                  <% if policy(Customer).index? %>
                    <%= link_to "Customers", customers_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                  <% end %>
                  <%= link_to "Inspections", inspections_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                  <%= link_to "Next Inspections", next_inspections_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                  <% if policy(:company_settings).index? %>
                    <%= link_to "Settings", settings_path, class: "text-slate-300 hover:text-white px-3 py-2 rounded-lg hover:bg-white/10 transition-all text-sm font-medium" %>
                  <% end %>
                  <!-- Logout Link -->
                  <div class="pt-2 mt-2 border-t border-white/10">
                    <%= link_to destroy_user_session_path, method: :delete,
                      class: "text-red-300 hover:text-red-200 px-3 py-2 rounded-lg hover:bg-red-500/10 transition-all text-sm font-medium flex items-center space-x-2" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                      </svg>
                      <span>Sign Out</span>
                    <% end %>
                  </div>
                </div>
              </nav>
            </div>
          </div>
          <!-- PWA Install/Update Buttons - Anclados debajo del header -->
          <div class="sticky top-[73px] z-40 flex justify-end px-4 py-2">
            <div class="flex space-x-2">
              <!--
              <button data-pwa-target="installButton"
                    data-action="click->pwa#install"
                class="hidden bg-blue-600/90 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg shadow-lg transition-colors duration-200 text-md font-medium backdrop-blur-sm border border-blue-500/30">
                📱 Install App
              </button>
              -->
              <button data-pwa-target="updateButton"
                    data-action="click->pwa#updateServiceWorker"
                class="hidden bg-green-600/90 hover:bg-green-700 text-white px-3 py-1.5 rounded-lg shadow-lg transition-colors duration-200 text-xs font-medium backdrop-blur-sm border border-green-500/30">
                🔄 Update Available
              </button>
            </div>
          </div>
        </header>
      <% end %>
      <!-- Flash Messages -->
      <% if flash.any? %>
        <div class="fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg">
          <% flash.each do |type, message| %>
            <% flash_class = case type.to_sym
                    when :notice, :success
                      "bg-green-500/90 border-green-400 text-white"
                    when :error, :alert
                      "bg-red-500/90 border-red-400 text-white"
                    else
                      "bg-blue-500/90 border-blue-400 text-white"
                    end %>
            <div class="<%= flash_class %> px-4 py-3 pr-12 rounded-lg relative mb-4 border backdrop-blur-sm shadow-lg transition-opacity duration-500" role="alert" data-controller="flash">
              <span class="block sm:inline font-medium"><%= message %></span>
              <button type="button" class="absolute top-0 bottom-0 right-0 px-4 py-3 hover:bg-black/10 rounded-r-lg transition-colors" data-action="click->flash#close">
                <span class="sr-only">Close</span>
                <svg class="fill-current h-5 w-5" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                  <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z" />
                </svg>
              </button>
            </div>
          <% end %>
        </div>
      <% end %>
      <!-- Main content -->
      <main class="main-content">
        <%= yield %>
      </main>
      <!-- Footer Global -->
      <% unless controller_name == 'form_fills' && action_name == 'show' %>
        <footer class="bg-white/5 backdrop-blur-sm border-t border-white/10 py-6 mt-12">
          <div class="container mx-auto px-4">
            <div class="flex flex-col lg:flex-row justify-between items-center space-y-4 lg:space-y-0">
              <!-- Company information -->
              <div class="text-center lg:text-left">
                <p class="text-slate-400 text-sm">
                  © <%= Date.current.year %> AES  - Professional solution for inspections
                </p>
              </div>
              <!-- Useful links -->
              <div class="flex space-x-6">
                <%= link_to "Home", root_path, class: "text-slate-400 hover:text-white text-sm transition-colors" %>
                <a href="#" class="text-slate-400 hover:text-white text-sm transition-colors">Support</a>
                <a href="#" class="text-slate-400 hover:text-white text-sm transition-colors">Help</a>
              </div>
            </div>
          </div>
        </footer>
      <% end %>
      <!-- Modal para manejar duplicados de Next Inspection -->
      <% if session[:duplicate_next_inspection] %>
        <%= render 'shared/duplicate_next_inspection_modal' %>
      <% end %>
    </div>
  </body>
</html>
