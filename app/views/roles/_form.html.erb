<%# app/views/roles/_form.html.erb %>

<%= form_with(model: role, class: "space-y-6") do |form| %>
  <% if role.errors.any? %>
    <div id="error_explanation" class="bg-red-500/10 text-red-300 p-4 rounded-lg border border-red-500/20">
      <h2 class="text-lg font-bold mb-2"><%= pluralize(role.errors.count, "error") %> prohibited this role from being saved:</h2>
      <ul class="list-disc list-inside">
        <% role.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :level, class: "block text-sm font-semibold text-slate-300 mb-2" %>
    <%= form.text_field :level, class: "w-full bg-slate-700/50 border border-white/10 rounded-lg px-4 py-2 text-white focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-colors", placeholder: "e.g., Administrator" %>
  </div>

  <div class="flex justify-end gap-4">
    <%= link_to "Cancel", settings_path, class: "text-slate-300 hover:text-white px-4 py-2 rounded-lg transition-colors" %>
    <%= form.submit "Save Role", class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02]" %>
  </div>
<% end %>