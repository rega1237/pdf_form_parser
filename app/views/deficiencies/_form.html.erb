<%= form_with(model: deficiency, local: true, class: "contents") do |form| %>
  <% if deficiency.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/20 rounded-2xl p-4 mb-6 animate-slide-up">
      <div class="flex items-center mb-3">
        <svg class="w-5 h-5 text-red-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h3 class="text-red-400 font-semibold">
          <%= pluralize(deficiency.errors.count, "error") %> prevented this deficiency from being saved:
        </h3>
      </div>
      <ul class="list-disc list-inside space-y-1">
        <% deficiency.errors.each do |error| %>
          <li class="text-red-300 text-sm"><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-6">
    <!-- Campo Nombre -->
    <div class="animate-fade-in">
      <%= form.label :name, "Name of the Deficiency", 
          class: "block text-white font-semibold text-sm lg:text-base mb-3" %>
      
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"/>
          </svg>
        </div>
        
        <%= form.text_field :name,
            class: ["w-full bg-white/5 border rounded-xl py-3 pl-12 pr-4 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200",
                   deficiency.errors[:name].any? ? "border-red-500/50 focus:ring-red-500" : "border-white/20 focus:ring-indigo-500"],
            placeholder: "Ej: Grieta en estructura, Corrosión visible, etc." %>
      </div>
      
      <% if deficiency.errors[:name].any? %>
        <div class="mt-2 flex items-center text-red-400 text-sm">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/>
          </svg>
          <%= deficiency.errors[:name].first %>
        </div>
      <% end %>
    </div>

    <!-- Botones de acción -->
    <div class="flex flex-col sm:flex-row gap-3 pt-4">
      <%= form.submit class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900" %>
      
      <%= link_to "Cancelar", settings_path, 
          class: "bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 px-6 rounded-xl transition-colors duration-200 text-center focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 focus:ring-offset-slate-900" %>
    </div>
  </div>
<% end %>
