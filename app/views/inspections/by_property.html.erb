<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    
    <!-- Header with navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">
          Property Inspections
        </h1>
        <div class="flex flex-col sm:flex-row sm:items-center text-slate-300 text-sm lg:text-base">
          <span class="text-emerald-400 font-semibold"><%= @customer.name %></span>
          <span class="text-slate-400 mx-2 hidden sm:inline">•</span>
          <span class="text-blue-400 font-semibold"><%= @property.property_name %></span>
          <span class="text-slate-400 mx-2 hidden sm:inline">•</span>
          <span class="text-slate-300"><%= pluralize(@total_inspections, 'inspection') %></span>
          <% if @inspections.respond_to?(:current_page) && @total_inspections > 10 %>
            <span class="text-slate-400 mx-2">•</span>
            <span class="text-slate-400 text-sm">
              Showing <%= @inspections.offset_value + 1 %>-<%= [@inspections.offset_value + @inspections.limit_value, @total_inspections].min %> of <%= @total_inspections %>
            </span>
          <% end %>
        </div>
      </div>
      
      <div class="flex items-center space-x-3">
        <%= link_to new_inspection_path(property_id: @property.id), 
            class: "inline-flex items-center px-4 py-2 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white rounded-xl transition-all duration-200 transform hover:scale-[1.02] text-sm font-medium" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Inspection
        <% end %>
        
        <%= link_to property_path(@property), 
            class: "inline-flex items-center px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl transition-all duration-200 transform hover:scale-[1.02] text-sm font-medium" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Property
        <% end %>
      </div>
    </div>

    <!-- Property Summary Card -->
    <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 border border-white/20 shadow-2xl mb-8 animate-slide-up">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="text-3xl font-bold text-emerald-400 mb-1"><%= @total_inspections %></div>
          <div class="text-slate-300 text-sm">Total Inspections</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-blue-400 mb-1"><%= @completed_inspections %></div>
          <div class="text-slate-300 text-sm">Completed</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-amber-400 mb-1"><%= @pending_inspections %></div>
          <div class="text-slate-300 text-sm">Pending</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-red-400 mb-1"><%= @due_soon_inspections %></div>
          <div class="text-slate-300 text-sm">Due Soon</div>
        </div>
      </div>
    </div>

    <!-- Inspections List -->
    <% if @inspections.any? %>
      <div class="space-y-4">
        <% @inspections.each_with_index do |inspection, index| %>
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20 shadow-xl hover:bg-white/15 transition-all duration-200 animate-slide-up" style="animation-delay: <%= index * 0.1 %>s;">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
              
              <!-- Left side - Main info -->
              <div class="flex-1 mb-4 lg:mb-0">
                <div class="flex items-start space-x-4">
                  <!-- Status badge -->
                  <div class="mt-1">
                    <% case inspection.status %>
                    <% when 'completed' %>
                      <div class="w-3 h-3 bg-emerald-500 rounded-full"></div>
                    <% when 'pending' %>
                      <div class="w-3 h-3 bg-amber-500 rounded-full"></div>
                    <% when 'in_progress' %>
                      <div class="w-3 h-3 bg-blue-500 rounded-full animate-pulse"></div>
                    <% when 'cancelled' %>
                      <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                    <% else %>
                      <div class="w-3 h-3 bg-slate-500 rounded-full"></div>
                    <% end %>
                  </div>
                  
                  <!-- Inspection details -->
                  <div class="flex-1">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-4 mb-2">
                      <h3 class="text-lg font-semibold text-white">
                        <%= inspection.system_category.presence || "System Inspection" %>
                      </h3>
                      <div class="flex items-center space-x-2 text-sm text-slate-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <span><%= inspection.date.strftime("%B %d, %Y") if inspection.date %></span>
                      </div>
                    </div>
                    
                    <div class="flex flex-wrap items-center gap-3 text-sm">
                      <!-- Interval category -->
                      <% if inspection.interval_category.present? %>
                        <div class="inline-flex items-center px-3 py-1 bg-blue-500/20 text-blue-300 rounded-lg">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                          <%= inspection.interval_category %>
                        </div>
                      <% end %>
                      
                      <!-- Status badge -->
                      <div class="inline-flex items-center px-3 py-1 rounded-lg
                        <%= case inspection.status
                            when 'completed' then 'bg-emerald-500/20 text-emerald-300'
                            when 'pending' then 'bg-amber-500/20 text-amber-300'
                            when 'in_progress' then 'bg-blue-500/20 text-blue-300'
                            when 'cancelled' then 'bg-red-500/20 text-red-300'
                            else 'bg-slate-500/20 text-slate-300'
                            end %>">
                        <%= inspection.status.humanize %>
                      </div>
                      
                      <!-- Form fill indicator -->
                      <% if inspection.form_fills.any? %>
                        <div class="inline-flex items-center px-3 py-1 bg-indigo-500/20 text-indigo-300 rounded-lg">
                          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                          </svg>
                          Form Available
                        </div>
                      <% end %>
                    </div>
                    
                    <!-- Notes preview -->
                    <% if inspection.notes.present? %>
                      <div class="mt-3 text-slate-300 text-sm">
                        <p class="line-clamp-2"><%= truncate(inspection.notes, length: 120) %></p>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
              
              <!-- Right side - Actions -->
              <div class="flex items-center space-x-3 lg:ml-6">
                <!-- View inspection -->
                <%= link_to inspection_path(inspection), 
                    class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors duration-200 text-sm font-medium" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  View
                <% end %>
                
                <!-- Edit inspection -->
                <%= link_to edit_inspection_path(inspection), 
                    class: "inline-flex items-center px-4 py-2 bg-slate-600 hover:bg-slate-700 text-white rounded-lg transition-colors duration-200 text-sm font-medium" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                  Edit
                <% end %>
                
                <!-- View form fill if available -->
                <% if inspection.form_fills.any? %>
                  <%= link_to form_fill_path(inspection.form_fills.last), 
                      class: "inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg transition-colors duration-200 text-sm font-medium" do %>
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Form
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <!-- Custom Pagination -->
      <% if @inspections.respond_to?(:current_page) && @inspections.total_pages > 1 %>
        <div class="flex justify-center mt-8">
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
            <div class="flex items-center space-x-2">
              
              <!-- Previous button -->
              <% if @inspections.prev_page %>
                <%= link_to property_inspections_path(@property, page: @inspections.prev_page), 
                    class: "inline-flex items-center px-3 py-2 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white rounded-lg transition-all duration-200 border border-white/10 hover:border-white/20" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                  </svg>
                  Previous
                <% end %>
              <% else %>
                <span class="inline-flex items-center px-3 py-2 bg-white/5 text-slate-500 rounded-lg border border-white/5 cursor-not-allowed">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                  </svg>
                  Previous
                </span>
              <% end %>
              
              <!-- Page numbers -->
              <div class="flex items-center space-x-1">
                <% if @inspections.current_page > 3 %>
                  <%= link_to "1", property_inspections_path(@property, page: 1), 
                      class: "px-3 py-2 text-slate-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors duration-200" %>
                  <% if @inspections.current_page > 4 %>
                    <span class="px-2 text-slate-500">...</span>
                  <% end %>
                <% end %>
                
                <% ([@inspections.current_page - 2, 1].max..[@inspections.current_page + 2, @inspections.total_pages].min).each do |page| %>
                  <% if page == @inspections.current_page %>
                    <span class="px-3 py-2 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-lg font-semibold">
                      <%= page %>
                    </span>
                  <% else %>
                    <%= link_to page, property_inspections_path(@property, page: page), 
                        class: "px-3 py-2 text-slate-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors duration-200" %>
                  <% end %>
                <% end %>
                
                <% if @inspections.current_page < @inspections.total_pages - 2 %>
                  <% if @inspections.current_page < @inspections.total_pages - 3 %>
                    <span class="px-2 text-slate-500">...</span>
                  <% end %>
                  <%= link_to @inspections.total_pages, property_inspections_path(@property, page: @inspections.total_pages), 
                      class: "px-3 py-2 text-slate-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors duration-200" %>
                <% end %>
              </div>
              
              <!-- Next button -->
              <% if @inspections.next_page %>
                <%= link_to property_inspections_path(@property, page: @inspections.next_page), 
                    class: "inline-flex items-center px-3 py-2 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white rounded-lg transition-all duration-200 border border-white/10 hover:border-white/20" do %>
                  Next
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                <% end %>
              <% else %>
                <span class="inline-flex items-center px-3 py-2 bg-white/5 text-slate-500 rounded-lg border border-white/5 cursor-not-allowed">
                  Next
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              <% end %>
            </div>
            
            <!-- Page info -->
            <div class="text-center mt-3 text-sm text-slate-400">
              Showing <%= @inspections.offset_value + 1 %>-<%= [@inspections.offset_value + @inspections.limit_value, @total_inspections].min %> 
              of <%= @total_inspections %> inspections
            </div>
          </div>
        </div>
      <% end %>
      
    <% else %>
      <!-- Empty state -->
      <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-12 border border-white/10 text-center animate-fade-in">
        <div class="w-24 h-24 mx-auto mb-6 bg-slate-700/50 rounded-2xl flex items-center justify-center">
          <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-3">No Inspections Found</h3>
        <p class="text-slate-300 mb-8 max-w-md mx-auto">
          This property doesn't have any inspections yet. Create the first inspection to get started with monitoring this property.
        </p>
        <%= link_to new_inspection_path(property_id: @property.id), 
            class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-700 hover:to-emerald-800 text-white font-semibold rounded-xl transition-all duration-200 transform hover:scale-[1.02]" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Create First Inspection
        <% end %>
      </div>
    <% end %>
  </div>
</div>