<div data-controller="inspection-modal"
     data-inspection-modal-system-categories-value="<%= @system_categories.map { |sc| { id: sc.id, name: sc.name, thumbnail_url: (sc.thumbnail.attached? ? url_for(sc.thumbnail) : nil) } }.to_json %>"
     data-inspection-modal-interval-categories-value="<%= @intervals.map { |ic| { id: ic.id, name: ic.name } }.to_json %>">

  <%# Vista 1: Contenido del Formulario (lo que se muestra por defecto) %>
  <div data-inspection-modal-target="formContent">
    <div class="space-y-6">
      <%# Botón para seleccionar System Category %>
      <div>
        <%= f.label :system_category, class: "block text-sm font-medium text-slate-300 mb-1" %>
        <button type="button" data-action="click->inspection-modal#openSystemModal" class="flex items-center justify-between w-full p-3 bg-slate-700/50 border border-white/10 rounded-lg hover:border-white/20 transition-colors">
          <span data-inspection-modal-target="systemCategoryDisplay" class="text-slate-400">Select System Category</span>
          <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
        <%= f.hidden_field :system_category, "data-inspection-modal-target": "systemCategoryInput" %>
      </div>

      <%# Botón para seleccionar Interval Category %>
      <div>
        <%= f.label :interval_category, class: "block text-sm font-medium text-slate-300 mb-1" %>
        <button type="button" data-action="click->inspection-modal#openIntervalModal" class="flex items-center justify-between w-full p-3 bg-slate-700/50 border border-white/10 rounded-lg hover:border-white/20 transition-colors">
          <span data-inspection-modal-target="intervalCategoryDisplay" class="text-slate-400">Select Interval Category</span>
           <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
        <%= f.hidden_field :interval_category, "data-inspection-modal-target": "intervalCategoryInput" %>
      </div>
    </div>
  </div>

  <%# Selección de System Category (oculto por defecto) %>
  <div data-inspection-modal-target="systemSelection" class="hidden">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white">Select System</h2>
      <button type="button" data-action="click->inspection-modal#backToForm" class="text-slate-400 hover:text-white">&times;</button>
    </div>
    <div data-inspection-modal-target="systemCategoryButtons" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <%# Los botones se generarán aquí por Stimulus %>
    </div>
  </div>

  <%# Selección de Interval Category (oculto por defecto) %>
  <div data-inspection-modal-target="intervalSelection" class="hidden">
     <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-white">Select Interval</h2>
      <button type="button" data-action="click->inspection-modal#backToSystemSelection" class="text-slate-400 hover:text-white">← Back</button>
    </div>
    <div data-inspection-modal-target="intervalCategoryButtons" class="space-y-3">
       <%# Los botones se generarán aquí por Stimulus %>
    </div>
  </div>
</div>