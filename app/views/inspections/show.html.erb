<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900" 
     data-controller="inspection-status" 
     data-inspection-status-inspection-id-value="<%= @inspection.id %>">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    <!-- Header con navegación -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div>
        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 bg-indigo-500/20 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <span>Inspection #<%= @inspection.id %></span>
          </div>
        </h1>
        <p class="text-slate-300 text-sm lg:text-base">Full details of the scheduled inspection</p>
      </div>
      <div class="flex space-x-3 mt-4 sm:mt-0">
        <%= link_to edit_inspection_path(@inspection), 
            class: "inline-flex items-center bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02]" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Edit
        <% end %>
        <%= link_to inspections_path, 
            class: "inline-flex items-center bg-slate-700 hover:bg-slate-600 text-white font-bold py-3 px-6 rounded-xl transition-colors duration-200" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back
        <% end %>
      </div>
    </div>
    <!-- Contenido principal -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Columna principal -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Detalles de la inspección -->
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center mb-6">
            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <h3 class="text-white font-semibold text-lg">Inspection Details</h3>
          </div>
          <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <dt class="text-slate-400 text-sm font-medium mb-1">Date</dt>
                <dd class="text-white text-sm lg:text-base"><%= @inspection.date.strftime('%d de %B de %Y') %></dd>
              </div>
              <div>
                <dt class="text-slate-400 text-sm font-medium mb-1">Status</dt>
                <dd class="mt-1">
                  <span class="inline-flex px-3 py-1 text-xs font-semibold rounded-full">
                    <%= status_badge_with_icon(@inspection.status) %>
                  </span>
                </dd>
              </div>
            </div>
            <!-- Customer Info -->
            <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-emerald-500/20 rounded-lg flex items-center justify-center mt-1">
                  <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-white font-semibold mb-2">Customer</h4>
                  <div class="space-y-2">
                    <div class="text-slate-300 font-medium"><%= @customer.name %></div>
                    <div class="text-slate-400 text-sm"><%= @customer.address %></div>
                    <div class="flex flex-wrap gap-3 text-sm">
                      <% if @customer.email.present? %>
                        <%= mail_to @customer.email, @customer.email, 
                            class: 'text-indigo-400 hover:text-indigo-300 transition-colors duration-200' %>
                      <% end %>
                      <% if @customer.phone_1.present? %>
                        <%= link_to @customer.phone_1, "tel:#{@customer.phone_1}", 
                            class: 'text-indigo-400 hover:text-indigo-300 transition-colors duration-200' %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Property Info -->
            <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mt-1">
                  <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-white font-semibold mb-2">Property</h4>
                  <div class="space-y-2">
                    <div class="text-slate-300 font-medium"><%= @property.property_name %></div>
                    <div class="text-slate-400 text-sm"><%= @property.address %>, <%= @property.city %> <%= @property.zip_code %></div>
                    <div class="flex flex-wrap gap-2 mt-3">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-slate-700/50 text-slate-300 border border-white/10">
                        <%= @property.property_type %>
                      </span>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-slate-700/50 text-slate-300 border border-white/10">
                        <%= @property.construction_type %>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Form Info -->
            <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
              <div class="flex items-start space-x-3">
                <div class="w-8 h-8 bg-amber-500/20 rounded-lg flex items-center justify-center mt-1">
                  <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <div class="flex-1">
                  <h4 class="text-white font-semibold mb-2">Form</h4>
                  <div class="space-y-3">
                    <div class="text-slate-300 font-medium"><%= @form_template.name %></div>
                    <% if @form_fill.present? %>
                      <div class="text-slate-400 text-sm">Filled form: <%= @form_fill.name %></div>
                    <% else %>
                      <div class="text-slate-400 text-sm">No form filled for this inspection</div>
                    <% end %>
                    <!-- All Buttons - Responsive Layout -->
                    <div class="flex flex-col sm:flex-row gap-3 mt-3">
                      <!-- Main Form Button -->
                      <% if @form_fill.present? %>
                        <%= link_to 'Continue Filling Form', form_fill_path(@form_fill), 
          class: 'inline-flex items-center justify-center bg-gradient-to-r from-blue-500 to-blue-700 hover:from-blue-600 hover:to-blue-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] flex-1 sm:flex-none' %>
                      <% else %>
                        <%= link_to 'Create Form', new_form_fill_path(form_template_id: @form_template.id, inspection_id: @inspection.id), 
          class: 'inline-flex items-center justify-center bg-gradient-to-r from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] flex-1 sm:flex-none' %>
                      <% end %>
                      <!-- Additional Risers Button -->
                      <% if @additional_risers_form_fill.present? %>
                        <%= link_to 'Additional Risers', form_fill_path(@additional_risers_form_fill), 
          class: 'inline-flex items-center justify-center bg-gradient-to-r from-purple-500 to-purple-700 hover:from-purple-600 hover:to-purple-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] flex-1 sm:flex-none' %>
                      <% end %>
                      <!-- Corrected Deficiencies Button -->
                      <% if @corrections_form_fill.present? %>
                        <%= link_to 'Corrected Deficiencies', form_fill_path(@corrections_form_fill), 
          class: 'inline-flex items-center justify-center bg-gradient-to-r from-orange-500 to-orange-700 hover:from-orange-600 hover:to-orange-800 text-white font-bold py-2 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02] flex-1 sm:flex-none' %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Notes -->
            <% if @inspection.notes.present? %>
              <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
                <div class="flex items-start space-x-3">
                  <div class="w-8 h-8 bg-slate-500/20 rounded-lg flex items-center justify-center mt-1">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <h4 class="text-white font-semibold mb-2">Notes</h4>
                    <p class="text-slate-300 text-sm whitespace-pre-wrap"><%= @inspection.notes %></p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Columna lateral -->
      <div class="space-y-6">
        <!-- Quick Actions -->
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center mb-6">
            <div class="w-8 h-8 bg-indigo-500/20 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-white font-semibold text-lg">Quick Actions</h3>
          </div>
          <div class="space-y-3">
            <button data-action="click->inspection-status#updateStatus" 
              data-status="completed"
              class="w-full bg-gradient-to-r from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02]">
              <div class="flex items-center justify-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Mark as Completed
              </div>
            </button>
            <button data-action="click->inspection-status#updateStatus" 
              data-status="in_progress"
              class="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02]">
              <div class="flex items-center justify-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                In Progress
              </div>
            </button>
            <button data-action="click->inspection-status#updateStatus" 
              data-status="pending"
              class="w-full bg-slate-700 hover:bg-slate-600 text-white font-bold py-3 px-4 rounded-xl transition-colors duration-200">
              <div class="flex items-center justify-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Mark as Pending
              </div>
            </button>
            <button data-action="click->inspection-status#updateStatus" 
              data-status="cancelled"
              class="w-full bg-gradient-to-r from-red-500 to-red-700 hover:from-red-600 hover:to-red-800 text-white font-bold py-3 px-4 rounded-xl transition-all duration-300 transform hover:scale-[1.02]">
              <div class="flex items-center justify-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Cancel Inspection
              </div>
            </button>
          </div>
        </div>
        <!-- Sprinklers Data -->
        <% if @form_fill.present? %>
          <% sprinklers_data = @form_fill.get_sprinklers_data %>
          <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
            <div class="flex items-center mb-6">
              <div class="w-8 h-8 bg-orange-500/20 rounded-lg flex items-center justify-center mr-3">
                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              </div>
              <h3 class="text-white font-semibold text-lg">Sprinklers Information</h3>
            </div>
            <div class="space-y-4">
              <!-- Number of Sprinklers -->
              <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4 border border-white/10">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-blue-500/20 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <dt class="text-slate-400 text-sm font-medium">Number of Sprinklers</dt>
                    <dd class="text-white text-lg font-semibold">
                      <%= sprinklers_data[:number].present? ? sprinklers_data[:number] : 'Not specified' %>
                    </dd>
                  </div>
                </div>
              </div>
              <!-- Manufacturing Date -->
              <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4 border border-white/10">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-emerald-500/20 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <dt class="text-slate-400 text-sm font-medium">Manufacturing Date</dt>
                    <dd class="text-white text-base font-semibold">
                      <%= sprinklers_data[:date].present? ? sprinklers_data[:date] : 'Not specified' %>
                    </dd>
                  </div>
                </div>
              </div>
              <!-- Brand -->
              <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4 border border-white/10">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-purple-500/20 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <dt class="text-slate-400 text-sm font-medium">Brand</dt>
                    <dd class="text-white text-base font-semibold">
                      <%= sprinklers_data[:brand].present? ? sprinklers_data[:brand] : 'Not specified' %>
                    </dd>
                  </div>
                </div>
              </div>
              <!-- Notes -->
              <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4 border border-white/10">
                <div class="flex items-start space-x-3">
                  <div class="w-10 h-10 bg-slate-500/20 rounded-lg flex items-center justify-center mt-1">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                  </div>
                  <div class="flex-1">
                    <dt class="text-slate-400 text-sm font-medium mb-1">Notes</dt>
                    <dd class="text-white text-sm">
                      <% if sprinklers_data[:notes].present? %>
                        <p class="whitespace-pre-wrap"><%= sprinklers_data[:notes] %></p>
                      <% else %>
                        <span class="text-slate-500 italic">No notes available</span>
                      <% end %>
                    </dd>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <!-- Form Results Summary -->
        <% if @form_fill.present? %>
          <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
            <div class="flex items-start space-x-3">
              <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center mt-1">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <h4 class="text-white font-semibold mb-4">Form Results Summary</h4>
                <div class="grid grid-cols-3 gap-4">
                  <div class="text-center">
                    <div class="w-12 h-12 bg-emerald-500/20 rounded-xl flex items-center justify-center mx-auto mb-2">
                      <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                    </div>
                    <div class="text-2xl font-bold text-emerald-400"><%= @form_counts[:pass] %></div>
                    <div class="text-slate-400 text-sm">Pass</div>
                  </div>
                  <div class="text-center">
                    <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center mx-auto mb-2">
                      <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                      </svg>
                    </div>
                    <div class="text-2xl font-bold text-red-400"><%= @form_counts[:fail] %></div>
                    <div class="text-slate-400 text-sm">Fail</div>
                  </div>
                  <div class="text-center">
                    <div class="w-12 h-12 bg-slate-500/20 rounded-xl flex items-center justify-center mx-auto mb-2">
                      <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                      </svg>
                    </div>
                    <div class="text-2xl font-bold text-slate-400"><%= @form_counts[:na] %></div>
                    <div class="text-slate-400 text-sm">N/A</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
        <!-- Additional Information -->
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
          <div class="flex items-center mb-6">
            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center mr-3">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-white font-semibold text-lg">Additional Information</h3>
          </div>
          <dl class="space-y-4">
            <div>
