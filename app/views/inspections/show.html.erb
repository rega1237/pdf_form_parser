            </div>
            <div>
              <dt class="text-slate-400 text-sm font-medium">Last updated</dt>
              <dd class="text-slate-300 text-sm mt-1"><%= @inspection.updated_at.strftime('%d/%m/%Y %H:%M') %></dd>
