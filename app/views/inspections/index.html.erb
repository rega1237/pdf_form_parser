<div class="min-h-screen">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    <!-- Header with navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <h1 class="text-2xl lg:text-3xl font-bold text-white mb-2">Inspections</h1>
        <p class="text-slate-300 text-sm lg:text-base">Manage and track all your field inspections</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 sm:space-x-3 w-full sm:w-auto">
        <!-- Offline Status Indicator -->
        <div class="inline-flex justify-center items-center bg-slate-700/50 px-4 py-2 rounded-xl border border-white/10 w-full sm:w-auto" data-controller="offline-status">
        <div class="flex items-center">
             <div class="w-2 h-2 rounded-full mr-2" data-offline-status-target="indicator"></div>
             <span class="text-white text-sm" data-offline-status-target="text">Checking...</span>
           </div>
         </div>
        <!-- Sync Button -->
        <div class="inline-flex items-center w-full sm:w-auto" data-controller="sync">
          <button data-action="click->sync#startSync" 
                  data-sync-target="syncButton"
                  class="w-full sm:w-auto bg-orange-600 hover:bg-orange-700 text-white px-3 py-2 sm:px-4 sm:py-2 rounded-xl text-sm sm:text-base transition-all duration-200 backdrop-blur-sm border border-white/10 hover:scale-105 flex items-center justify-center">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            Sync (<span data-sync-target="syncCount">0</span>)
          </button>
          <div data-sync-target="syncStatus" class="ml-4 hidden">
            <div class="w-32 bg-slate-700 rounded-full h-2">
              <div data-sync-target="progressBar" class="bg-orange-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>
            <div data-sync-target="progressText" class="text-xs text-slate-300 mt-1">Syncing...</div>
          </div>
        </div>
        <%= link_to calendar_inspections_path, class: "w-full sm:w-auto inline-flex items-center justify-center bg-slate-700/50 hover:bg-slate-600/50 text-white px-3 py-2 sm:px-4 sm:py-2 rounded-xl text-sm sm:text-base transition-all duration-200 backdrop-blur-sm border border-white/10 hover:scale-105" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          Calendar View
        <% end %>
        <% if policy(@inspections).create? %>
          <%= link_to new_inspection_path, 
            class: "w-full sm:w-auto bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold px-4 py-2 sm:px-6 sm:py-3 rounded-xl transition-all duration-300 transform hover:scale-[1.02] inline-flex items-center justify-center text-sm sm:text-base" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            New Inspection
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Indicador de almacenamiento local -->
    <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 border border-white/20 shadow-2xl mb-8" data-controller="storage-stats">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center">
          <div class="w-8 h-8 bg-indigo-500/20 rounded-lg flex items-center justify-center mr-3">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.1 0-2 .9-2 2v6h4v-6c0-1.1-.9-2-2-2zm0-4a4 4 0 014 4v1h1a3 3 0 013 3v6a3 3 0 01-3 3H8a3 3 0 01-3-3v-6a3 3 0 013-3h1V8a4 4 0 014-4z"></path>
            </svg>
          </div>
          <h2 class="text-white font-semibold text-lg">Local Storage</h2>
        </div>
        <div class="flex gap-2">
          <button data-action="storage-stats#cleanAll" class="bg-red-600/20 hover:bg-red-600/30 text-red-400 text-sm px-3 py-2 rounded-xl border border-red-500/30 transition-colors flex items-center" title="Delete all offline data">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            Clean All
          </button>
          <button data-action="storage-stats#refresh" class="bg-slate-700 hover:bg-slate-600 text-white text-sm px-3 py-2 rounded-xl border border-white/10 transition-colors">Refresh</button>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
        <div class="md:col-span-2">
          <div class="w-full bg-slate-700 rounded-full h-2">
            <div data-storage-stats-target="progressBar" class="bg-emerald-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <div class="text-xs text-slate-300 mt-2">
            <span>Usage: <span class="font-semibold text-white" data-storage-stats-target="usageText">0 B</span></span>
            <span class="ml-3">of <span class="font-semibold text-white" data-storage-stats-target="quotaText">0 B</span></span>
            <span class="ml-3">(<span class="font-semibold text-white" data-storage-stats-target="percentageText">0%</span>)</span>
          </div>
        </div>
        <div class="md:col-span-1 text-slate-300 text-sm" data-storage-stats-target="detailsText">
          <!-- Dynamic details: offline inspections, pending changes, sync queue -->
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl mb-8 animate-slide-up relative z-30">
      <div class="flex items-center mb-6">
        <div class="w-8 h-8 bg-emerald-500/20 rounded-lg flex items-center justify-center mr-3">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.707A1 1 0 013 7V4z"></path>
          </svg>
        </div>
        <h2 class="text-white font-semibold text-lg">Filters</h2>
      </div>
      <%= form_with url: inspections_path, method: :get, local: true, class: 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6' do |form| %>
        <!-- Customer Filter — Searchable Dropdown -->
        <div class="space-y-2 lg:col-span-2" data-controller="searchable-select">
          <%= form.label :customer_id, "Customer", class: "block text-white font-semibold text-sm lg:text-base" %>
 
          <%# Hidden input that carries the actual value in the GET form %>
          <input type="hidden"
                 name="customer_id"
                 id="filter_customer_id"
                 value="<%= params[:customer_id] %>"
                 data-searchable-select-target="hiddenInput">
 
          <%# Trigger button %>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <button type="button"
                    data-searchable-select-target="button"
                    data-action="click->searchable-select#toggle"
                    class="w-full bg-white/5 border border-white/20 rounded-xl py-3 pl-12 pr-10 text-left focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 hover:bg-white/10">
              <span data-searchable-select-target="buttonText" class="text-white truncate block">
                <%# Show current selection label or placeholder %>
                <% if params[:customer_id].present? %>
                  <%= @customers.find { |c| c.id.to_s == params[:customer_id].to_s }&.name || 'All Customers' %>
                <% else %>
                  All Customers
                <% end %>
              </span>
            </button>
            <svg class="absolute right-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
 
            <%# Dropdown panel — hidden by default %>
            <div data-searchable-select-target="optionsContainer"
                 class="hidden absolute left-0 right-0 z-50 mt-1 bg-slate-800 border border-white/20 rounded-xl shadow-2xl">
 
              <%# Search box %>
              <div class="p-2 border-b border-white/10">
                <div class="relative">
                  <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                  <input type="text"
                         placeholder="Search by name or address..."
                         data-searchable-select-target="searchInput"
                         data-action="input->searchable-select#search"
                         class="w-full bg-white/5 border border-white/10 rounded-lg py-2 pl-12 pr-4 text-white text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
              </div>
 
              <%# Options list %>
              <ul data-searchable-select-target="optionsList"
                  class="py-1 overflow-y-auto max-h-48">
                <%# "All Customers" placeholder option — clears the filter %>
                <li data-value=""
                    data-action="click->searchable-select#select"
                    class="px-4 py-2 text-slate-300 hover:bg-white/10 cursor-pointer text-sm transition-colors duration-100">
                  All Customers
                </li>
                <% @customers.each do |customer| %>
                  <li data-value="<%= customer.id %>"
                      data-label="<%= customer.name %>"
                      data-action="click->searchable-select#select"
                      class="px-4 py-2 cursor-pointer text-sm transition-colors duration-100 hover:bg-white/10 <%= params[:customer_id].to_s == customer.id.to_s ? 'bg-emerald-600/30 text-white font-medium' : 'text-slate-200' %>">
                    <%# Customer name is the primary visible text %>
                    <span class="font-medium"><%= customer.name %></span>
                    
                    <%# Properties are shown in small text and are searchable via textContent %>
                    <% if customer.properties.any? %>
                      <div class="mt-1 space-y-0.5 pointer-events-none">
                        <% customer.properties.each do |property| %>
                          <span class="block text-[10px] text-slate-400 opacity-70 leading-tight">
                            <%= property.property_name %> — <%= property.address %>
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>

        <!-- System Category Filter -->
        <div class="space-y-2">
          <%= form.label :system_category, "System Category", class: "block text-white font-semibold text-sm lg:text-base" %>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <%= form.select :system_category, options_for_select(@system_categories.map(&:name), params[:system_category]),
                           { prompt: 'All Categories' },
                           { class: "w-full bg-white/5 border border-white/20 rounded-xl py-3 pl-12 pr-10 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 appearance-none" } %>
            <svg class="absolute right-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>


 

 

 


        <!-- Status Filter -->
        <div class="space-y-2">
          <%= form.label :status, "Status", class: "block text-white font-semibold text-sm lg:text-base" %>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <%= form.select :status, options_for_select(@statuses.map {|s| [s.humanize, s]}, params[:status]),
                           { prompt: 'All Statuses' },
                           { class: "w-full bg-white/5 border border-white/20 rounded-xl py-3 pl-12 pr-10 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200 appearance-none" } %>
            <svg class="absolute right-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>
        <!-- From Date Filter -->
        <div class="space-y-2">
          <%= form.label :from_date, "From Date", class: "block text-white font-semibold text-sm lg:text-base" %>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <%= form.date_field :from_date, value: params[:from_date], 
                class: "w-full bg-white/5 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200" %>
          </div>
        </div>
        <!-- To Date Filter -->
        <div class="space-y-2">
          <%= form.label :to_date, "To Date", class: "block text-white font-semibold text-sm lg:text-base" %>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <%= form.date_field :to_date, value: params[:to_date], 
                class: "w-full bg-white/5 border border-white/20 rounded-xl py-3 pl-12 pr-4 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all duration-200" %>
          </div>
        </div>
        <!-- Filter Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 lg:col-span-3 lg:grid lg:grid-cols-2 lg:gap-6 mt-2">
          <%= form.submit 'Filter', 
              class: "bg-gradient-to-r from-emerald-500 to-emerald-700 hover:from-emerald-600 hover:to-emerald-800 text-white font-bold py-3.5 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] shadow-lg shadow-emerald-500/20" %>
          <%= link_to inspections_path, 
              class: "bg-slate-700 hover:bg-slate-600 text-white font-medium py-3.5 px-6 rounded-xl transition-colors duration-200 text-center flex items-center justify-center border border-white/10" do %>
            Clear Filters
          <% end %>
        </div>
      <% end %>
    </div>
    <!-- Inspections Table -->
    <div class="bg-white/10 backdrop-blur-sm rounded-3xl border border-white/20 shadow-2xl overflow-hidden animate-slide-up animate-stagger relative z-10">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-white/5 border-b border-white/10">
            <tr>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Actions</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Offline</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Start Inspection</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Corrected Deficiencies</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Date</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Customer</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Property</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-300 uppercase tracking-wider">Technician</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% @inspections.each do |inspection| %>
              <% main_form_fill = inspection.form_fills.find { |ff| ff.form_template_id == inspection.form_template_id } %>
              <tr class="hover:bg-white/5 transition-colors duration-200" data-controller="inspection-download" data-inspection-download-inspection-id-value="<%= inspection.id %>" data-inspection-download-inspection-title-value="<%= inspection.form_template.original_file.filename %>">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <div class="flex justify-center space-x-3">
                    <%= link_to inspection, class: 'inline-flex items-center justify-center w-11 h-11 rounded-full text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-800', title: 'View inspection', aria: { label: 'View inspection' } do %>
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                    <% end %>
                    <%= link_to edit_inspection_path(inspection), class: 'inline-flex items-center justify-center w-11 h-11 rounded-full text-emerald-400 hover:text-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-800', title: 'Edit inspection', aria: { label: 'Edit inspection' } do %>
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    <% end %>
                    <% if policy(inspection).destroy? %>
                      <%= link_to inspection_path(inspection), 
                          class: 'inline-flex items-center justify-center w-11 h-11 rounded-full text-red-400 hover:text-red-300 focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2 focus:ring-offset-slate-800', 
                          title: 'Delete inspection', 
                          aria: { label: 'Delete inspection' },
                          data: { action: "click->inspection-download#delete" } do %>
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                      <% end %>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                  <div class="flex justify-center items-center space-x-2">
                    <div data-inspection-download-target="statusIcon"></div>
                    <button data-inspection-download-target="downloadButton"></button>
                  </div>
                  <div class="progress-container mt-2 hidden" data-inspection-download-target="progressContainer">
                    <div class="w-full bg-slate-700 rounded-full h-2">
                      <div data-inspection-download-target="progressBar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <div data-inspection-download-target="progressText" class="text-xs text-slate-300 mt-1"></div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                  <% if main_form_fill %>
                    <div class="flex flex-col items-center space-y-2">
                      <% if inspection.status == 'completed' %>
                        <% if main_form_fill.filled_pdf.attached? %>
                          <%= link_to 'View PDF', download_pdf_form_fill_path(main_form_fill, disposition: 'inline'), target: '_blank', class: 'bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-lg transition-colors duration-200' %>
                        <% elsif main_form_fill.generating? %>
                          <span class="bg-slate-600 text-white font-medium py-2 px-4 rounded-lg opacity-70 cursor-not-allowed">Generating PDF...</span>
                        <% else %>
                          <%= link_to 'Generate PDF', submit_form_form_fill_path(main_form_fill), data: { turbo_method: :post }, class: 'bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg transition-colors duration-200' %>
                        <% end %>
                      <% else %>
                        <%= link_to 'Start Inspection', form_fill_path(main_form_fill), class: 'bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition-colors duration-200' %>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-slate-400 italic">No form</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center">
                  <% corrected_deficiencies_form_fill = inspection.form_fills.find { |ff| ff.form_template&.name == 'Corrected Deficiencies' } %>
                  <% if corrected_deficiencies_form_fill %>
                     <%= link_to 'Corrected Deficiencies', form_fill_path(corrected_deficiencies_form_fill), class: 'bg-yellow-600 hover:bg-yellow-700 text-white font-bold py-2 px-4 rounded-lg transition-colors duration-200' %>
                   <% else %>
                    <span class="text-slate-400 italic">No form</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-white font-medium"><%= inspection.date.strftime('%m/%d/%Y') %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-slate-300"><%= inspection.property.customer.name %></td>
                <td class="px-6 py-4 text-sm text-center">
                  <div class="text-white font-medium"><%= inspection.property.property_name %></div>
                  <div class="text-slate-400 text-xs mt-1"><%= inspection.property.address %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-center"><%= status_badge_with_icon(inspection.status) %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-slate-300">
                  <%= inspection.user&.display_name || 'Unassigned' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Custom Pagination -->
      <% if @inspections.respond_to?(:total_pages) && @inspections.total_pages > 1 %>
        <div class="flex justify-center py-6 border-t border-white/10 bg-white/5">
          <div class="bg-slate-800/80 backdrop-blur-sm rounded-2xl p-4 border border-white/10">
            <div class="flex items-center space-x-2">
              
              <!-- Previous button -->
              <% if @inspections.prev_page %>
                <%= link_to inspections_path(request.query_parameters.merge(page: @inspections.prev_page)), 
                    class: "inline-flex items-center px-3 py-2 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white rounded-lg transition-all duration-200 border border-white/10 hover:border-white/20" do %>
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                  </svg>
                  Previous
                <% end %>
              <% else %>
                <span class="inline-flex items-center px-3 py-2 bg-white/5 text-slate-500 rounded-lg border border-white/5 cursor-not-allowed">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                  </svg>
                  Previous
                </span>
              <% end %>
              
              <!-- Page numbers -->
              <div class="flex items-center space-x-1">
                <% if @inspections.current_page > 3 %>
                  <%= link_to "1", inspections_path(request.query_parameters.merge(page: 1)), 
                      class: "px-3 py-2 text-slate-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors duration-200" %>
                  <% if @inspections.current_page > 4 %>
                    <span class="px-2 text-slate-500">...</span>
                  <% end %>
                <% end %>
                
                <% ([@inspections.current_page - 2, 1].max..[@inspections.current_page + 2, @inspections.total_pages].min).each do |page| %>
                  <% if page == @inspections.current_page %>
                    <span class="px-3 py-2 bg-gradient-to-r from-indigo-600 to-indigo-700 text-white rounded-lg font-semibold">
                      <%= page %>
                    </span>
                  <% else %>
                    <%= link_to page, inspections_path(request.query_parameters.merge(page: page)), 
                        class: "px-3 py-2 text-slate-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors duration-200" %>
                  <% end %>
                <% end %>
                
                <% if @inspections.current_page < @inspections.total_pages - 2 %>
                  <% if @inspections.current_page < @inspections.total_pages - 3 %>
                    <span class="px-2 text-slate-500">...</span>
                  <% end %>
                  <%= link_to @inspections.total_pages, inspections_path(request.query_parameters.merge(page: @inspections.total_pages)), 
                      class: "px-3 py-2 text-slate-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors duration-200" %>
                <% end %>
              </div>
              
              <!-- Next button -->
              <% if @inspections.next_page %>
                <%= link_to inspections_path(request.query_parameters.merge(page: @inspections.next_page)), 
                    class: "inline-flex items-center px-3 py-2 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white rounded-lg transition-all duration-200 border border-white/10 hover:border-white/20" do %>
                  Next
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                <% end %>
              <% else %>
                <span class="inline-flex items-center px-3 py-2 bg-white/5 text-slate-500 rounded-lg border border-white/5 cursor-not-allowed">
                  Next
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Empty State -->
    <% if @inspections.empty? %>
      <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-12 border border-white/10 text-center animate-fade-in mt-8">
        <div class="w-16 h-16 bg-slate-500/20 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
          </svg>
        </div>
        <h3 class="text-white font-semibold text-lg mb-2">No Inspections Found</h3>
        <p class="text-slate-300 mb-6">Get started by creating your first inspection</p>
        <%= link_to new_inspection_path,
            class: "bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white font-bold py-3 px-6 rounded-xl transition-all duration-300 transform hover:scale-[1.02] inline-flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
          </svg>
          Create First Inspection
        <% end %>
      </div>
    <% end %>
  </div>
</div>
