<% content_for :head do %>
  <style>
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes slideUp {
      0% { opacity: 0; transform: translateY(30px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.6s ease-in-out; }
    .animate-slide-up { animation: slideUp 0.5s ease-out; }
  </style>
<% end %>

<% content_for :title, "Edit System Category" %>

<div class="min-h-screen">
  <div class="container mx-auto px-4 py-6 lg:py-12">
    
    <!-- Header with navigation -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 animate-fade-in">
      <div class="mb-4 sm:mb-0">
        <div class="flex items-center mb-2">
          <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-700 rounded-xl flex items-center justify-center mr-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <h1 class="text-2xl lg:text-3xl font-bold text-white">Edit System Category</h1>
        </div>
        <p class="text-slate-300 text-sm lg:text-base">
          Modify data for: <span class="text-blue-400 font-semibold"><%= @system_category.name %></span>
        </p>
      </div>
      
      <!-- Navigation buttons -->    
        <%= link_to settings_path, 
            class: "inline-flex items-center bg-slate-700 hover:bg-slate-600 text-white py-2 px-4 rounded-xl transition-colors duration-200 text-sm lg:text-base" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Settings
        <% end %>
      </div>
    </div>

    <!-- Main content -->
    <div class="max-w-2xl mx-auto">
      <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-6 lg:p-8 border border-white/20 shadow-2xl animate-slide-up">
        
        <!-- Current category information -->
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4 mb-6 border border-white/10">
          <div class="flex items-center">
            <div class="w-12 h-12 bg-white/5 rounded-lg flex items-center justify-center mr-3 border border-white/10">
              <% if @system_category.thumbnail.attached? %>
                <%= image_tag @system_category.thumbnail, 
                    class: "w-10 h-10 rounded-lg object-cover", 
                    alt: @system_category.name %>
              <% else %>
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              <% end %>
            </div>
            <div>
              <h3 class="text-white font-semibold text-sm">Editing system category</h3>
              <p class="text-slate-300 text-xs">
                ID: <%= @system_category.id %> • Created: <%= @system_category.created_at.strftime("%m/%d/%Y") %>
                <% if @system_category.thumbnail.attached? %>
                  <span class="inline-flex items-center ml-2">
                    <svg class="w-3 h-3 text-green-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <span class="text-green-400">With image</span>
                  </span>
                <% end %>
              </p>
            </div>
          </div>
        </div>
        
        <!-- Form -->
        <%= render "form", system_category: @system_category %>
        
      </div>
    </div>
  </div>
</div>
